// Show or hide all elements
void showHide(bool show) {
 	connectionStateBMP.visible = show;
 	timeSyncBtn.visible = show;
 	helpBtn.visible = show;
 	exitBtn.visible = false;
	backButton.visible = false;
 	dateLabel.visible = show;
 	timeLabel.visible = show;
 	NDateLabel.visible = show;
 	NTimeLabel.visible = show;
 	offsetLabel.visible = show;
 	offsetPopup.visible = show;
 	retryLabel.visible = show;
 	retriesField.visible = show;
 }
 
 
