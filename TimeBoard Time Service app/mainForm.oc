	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h/2);
	
	// Hide all elements
 	showHide(false);

	year = "";
	month = "";
	day = "";
	hour = "";
	minute = "";
	second = "";
	offset = "";
	
