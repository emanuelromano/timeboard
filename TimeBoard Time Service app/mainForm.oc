	timer(1);
}


handler mainForm.ondraw() {
	// Text adjustments
	separation = 6;
	newLine = 13;
	
	// Draw analog clock
	analogClockWidget(startX1, startY1);
	
	// App text
	mainBuffer.begin();
	mainBuffer.textRGB(highlightR, highlightG, highlightB);
	mainBuffer.font(fntLargeBold);
	mainBuffer.textAlign(00);
	mainBuffer.text(clrText, startX1+widgetW+separation, startY1, "TimeBoard");
	mainBuffer.text(clrText, startX1+widgetW+separation, startY1+newLine, "Time");
	mainBuffer.text(clrText, startX1+widgetW+separation, startY1+(newLine*2), "Service");
	
	// Show API and System versions if they exist
	if (apiVersion != "" && serviceVersion != "") {
    	mainBuffer.textAlign(20);
		mainBuffer.font(fntStandard);
		mainBuffer.text(clrText, startX1+widgetW+separation, startY1+widgetH-10, "API: " + apiVersion + "        ");
		mainBuffer.text(clrText, startX1+widgetW+separation, startY1+widgetH, "Service: v" + serviceVersion + "        ");
	}
	mainBuffer.end();
	
	// Draw mainBuffer
	draw.begin();
	draw.draw(mainBuffer, 0, 0);
	draw.end();
	
	// Show all elements
	showHide(true);
	
	// Checks if TimeBoard called the app, then show propper exit button
	if (TBTS.launchArgs == "TIMEBOARD") {
		exitBtn.enabled = false;
		exitBtn.visible = false;
		backButton.visible = true;
	}
	else
	{
		backButton.enabled = false;
		backButton.visible = false;
		exitBtn.visible = true;
	}
}


handler mainForm.ontimer() {
	string yyyy, MM, dd, hh, mm, ss;
	
	deviceDate.now();
	seconds = deviceDate.sec;

	if (!mainForm.obscured && seconds != timerLastSecond) {
		hours = deviceDate.hour;
		minutes = deviceDate.min;
		
		// Analog clock movement
		updateClockHands();
		
		// Draw mainBuffer
		draw.begin();
		draw.draw(mainBuffer, 0, 0); 
		draw.end();
		
		// Set date and time labels
		yyyy = "" + deviceDate.year;
	
		if (deviceDate.month < 10)
			MM = "0" + deviceDate.month;
		else
			MM = "" + deviceDate.month;
	
		if (deviceDate.day < 10)
			dd = "0" + deviceDate.day;
		else
			dd = "" + deviceDate.day;
	
		if (deviceDate.hour < 10)
			hh = "0" + deviceDate.hour;
		else
			hh = "" + deviceDate.hour;
	
		if (deviceDate.min < 10)
			mm = "0" + deviceDate.min;
		else
			mm = "" + deviceDate.min;
	
		if (deviceDate.sec < 10)
			ss = "0" + deviceDate.sec;
		else
			ss = "" + deviceDate.sec;
	
		NDateLabel.text = yyyy + "-" + MM + "-" + dd + "      ";
		NTimeLabel.text = hh + ":" + mm + ":" + ss + "      ";
	}
	
	timerLastSecond = seconds;
	timer(20);
}


// Time Sync button handler
handler timeSyncBtn.onselect() {
    int err,
        retries;
    bool resp;
	
	// Popup validation
    if (offsetPopup.text == "Select...") {
        alert("Please select the GMT offset according to the nearest city of your current location.");
        return;
    }
	
	// Retry attempts field validation
    retries = lparse(retriesField.text);
    if (retries <= 0) {
        alert("Retry attempts must be in the range 1 to 9.");
        return;
    }
    
	// Save GMT offset and retry number preferences
    resp = setNewPrefs(offsetList.selitem, retries);
    if (!resp) {
        alert("Error trying to save preferences.");
    }
	
    // Connecting...
    draw.begin();
    draw.bitmap(internetConnectingBMP, connectionStateBMP.x, connectionStateBMP.y);
    draw.end();

    err = downloadTime();

	if (err == 0) {
    	validResponse = processUTCResponse();
	
    	if (validResponse) {
    		// Save preferences again, now with updated API and Service versions
    		resp = setNewPrefs(offsetList.selitem, retries);
    		if (!resp) {
        		alert("Error trying to save preferences.");
    		}
    		
        	// Success
        	draw.begin();
        	draw.bitmap(internetSuccessBMP, connectionStateBMP.x, connectionStateBMP.y);
        	draw.end();
        	
        	// Show current API and Service versions
        	mainBuffer.begin();
        	mainBuffer.textRGB(highlightR, highlightG, highlightB);
        	mainBuffer.textAlign(20);
			mainBuffer.font(fntStandard);
			mainBuffer.text(clrText, startX1+widgetW+separation, startY1+widgetH-10, "API: " + apiVersion + "        ");
			mainBuffer.text(clrText, startX1+widgetW+separation, startY1+widgetH, "Service: v" + serviceVersion + "        ");
			mainBuffer.end();
			
        	setDateTime();
    	}
    	else
    	{
        	// Invalid server response
        	draw.begin();
        	draw.bitmap(internetErrorBMP, connectionStateBMP.x, connectionStateBMP.y);
        	draw.end();
    	}
	}
    else
    {
        // Error
        draw.begin();
        draw.bitmap(internetErrorBMP, connectionStateBMP.x, connectionStateBMP.y);
        draw.end();

        if (err == 429) {
            alertc(
                "Error",
                "Too many requests. Please try again later.\nError code: " + err,
                "OK",
                alertError
            );
        }
        else
        {
            alertc(
                "Error",
                "Unable to get time from the Internet.\nError code: " + err,
                "OK",
                alertError
            );
        }
    }
}


handler mainOptionsAbout.onselect() {
	alert("TimeBoard Time Service v" + TBTS.version + "\n@coloraturip\n©2026");
}


// Help button
handler helpBtn.onselect() {
	// Clean buffer before opening new form
	mainBuffer.release();
	
	helpForm.load();
}


// Exit the app
handler exitBtn.onselect() {
	TBTS.abort();
}


// Back to TimeBoard v2.X if installed
handler backButton.onselect() {
	launch("TBRD");
}


// Help menu option
handler mainOptionsHelp.onselect() {
	// Clean buffer before opening new form
	mainBuffer.release();
	
	helpForm.load();
}
