// Widget
const float pi = 3.14159265;
int seconds, hours, minutes, timerLastSecond,
	centerX, centerY,
	hourLength,
	minuteLength,
	secondLength;

float oldHourAngle,
	oldMinuteAngle,
	oldSecondAngle;

int startX1 = 8,
	startY1 = 8,
		
	widgetW = 70,
	widgetH = 70,
	
	cornerRadius = 8;

int fgColorR = 255,
	fgColorG = 255,
	fgColorB = 255,
	
	highlightR = 255,
	highlightG = 153,
	highlightB = 51,
	
	mainR = 51,
	mainG = 51,
	mainB = 51,
	
	useAnalogClockNumbers = 0;


// Round coordinates for drawing and angles
int roundCoord(float value) {
    if (value >= 0)
        return (int)(value + 0.5);
    else
        return (int)(value - 0.5);
}


// Draws hand with given parameters
void drawHand(float angle,
			  int length,
			  int centerX,
			  int centerY,
			  int r,
			  int g,
			  int b)
{
	int x, y;
	
	mainBuffer.begin();
	mainBuffer.fgRGB(r, g, b);

	x = centerX + roundCoord(cos(angle) * length);
	y = centerY + roundCoord(sin(angle) * length);

	mainBuffer.line(clrFG, centerX, centerY, x, y);
	mainBuffer.end();
}


void drawClockHands(int centerX, int centerY) {
	int x, y;
	float hourAngle,
		minuteAngle,
		secondAngle;

	// Angles
	hourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	minuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	secondAngle =
		((float)seconds * 6 - 90) / 180 * pi;

	// Draw hands
	drawHand(hourAngle,
			 hourLength,
			 centerX,
			 centerY,
			 mainR,
			 mainG,
			 mainB);

	drawHand(minuteAngle,
			 minuteLength,
			 centerX,
			 centerY,
			 mainR,
			 mainG,
			 mainB);

	drawHand(secondAngle,
			 secondLength,
			 centerX,
			 centerY,
			 highlightR,
			 highlightG,
			 highlightB);

	// Center
	mainBuffer.fgRGB(highlightR, highlightG, highlightB);
	mainBuffer.rect(clrFG,
		centerX - 1,
		centerY - 1,
		centerX + 2,
		centerY + 2,
		2);
	
	// Save for next draw in buffer
	oldHourAngle = hourAngle;
	oldMinuteAngle = minuteAngle;
	oldSecondAngle = secondAngle;
}


void updateClockHands() {
	float newHourAngle,
		newMinuteAngle,
		newSecondAngle;

	// 1) Delete old hands
	drawHand(oldHourAngle,
			 hourLength,
			 centerX,
			 centerY,
			 fgColorR,
			 fgColorG,
			 fgColorB);

	drawHand(oldMinuteAngle,
			 minuteLength,
			 centerX,
			 centerY,
			 fgColorR,
			 fgColorG,
			 fgColorB);

	drawHand(oldSecondAngle,
			 secondLength,
			 centerX,
			 centerY,
			 fgColorR,
			 fgColorG,
			 fgColorB);

	// 2) Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;

	// 3) Draw new hands
	drawHand(newHourAngle,
			 hourLength,
			 centerX,
			 centerY,
			 mainR,
			 mainG,
			 mainB);

	drawHand(newMinuteAngle,
			 minuteLength,
			 centerX,
			 centerY,
			 mainR,
			 mainG,
			 mainB);

	drawHand(newSecondAngle,
			 secondLength,
			 centerX,
			 centerY,
			 highlightR,
			 highlightG,
			 highlightB);

	// 4) Center
	mainBuffer.begin();
	mainBuffer.fgRGB(highlightR, highlightG, highlightB);

	mainBuffer.rect(clrFG,
		centerX - 1,
		centerY - 1,
		centerX + 2,
		centerY + 2,
		2);
	mainBuffer.end();

	// 5) Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2;
	float angle;
	string number;

	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	radius = (widgetW / 2) - (widgetW / 2) * 0.2;
	
	// Hands lenght
	hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
	minuteLength = (widgetW / 2) - (widgetW / 2) * 0.38;
	secondLength = (widgetW / 2) - (widgetW / 2) * 0.38;

	mainBuffer.begin();
	// Central point
	mainBuffer.fgRGB(mainR, mainG, mainB);
	mainBuffer.pixel(clrFG, centerX, centerY);
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
			mainBuffer.font(fntLarge);
			
			// Color for 3, 6, 9 & 12 numbers
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			mainBuffer.textRGB(highlightR, highlightG, highlightB);
    		}
    		else
    		{
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetW / 2) * 0.66;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetW / 2) * 0.70;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		if (i == 0 || i == 3 || i == 6 || i == 9) {
    			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		}
    		else
    		{
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    		}
    			
    		mainBuffer.line(clrFG, x1, y1, x2, y2);
		}
	}
	
	// Frame around clock
	mainBuffer.fgRGB(highlightR, highlightG, highlightB);
	mainBuffer.frame(clrFG, startX, startY, startX+widgetW, startY+widgetH, cornerRadius, 1);
	
	drawClockHands(centerX, centerY);
	mainBuffer.end();
}
