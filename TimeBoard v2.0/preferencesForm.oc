handler preferencesForm.onopen() {
	// Interface push buttons
	if (origInterfaceMode == 1)
		interfaceApush.checked = true;
	else
		interfaceBpush.checked = true;
	
	// Corners push buttons
	switch (widgetCornerRadius) {
		case 0:
			corner0push.checked = true;
			break;
		case 4:
			corner4push.checked = true;
			break;
		case 8:
			corner8push.checked = true;
			break;
	}
	
	// Hide Colors button in B/W & grayscale modes
	if (colorDepth < 8) {
		prefsColorsBtn.visible = false;
		colorsBmp.visible = false;
	}
}


handler preferencesForm.ondraw() {
	if (colorDepth > 4)
		colorsBmp.visible = true;
}


handler prefsColorsBtn.onselect() {
	colorsBmp.visible = true;
	colorsModalForm.domodal();
}


// Interface: Push button A
handler interfaceApush.onselect() {
	origInterfaceMode = 1;
}


// Interface: Push button B
handler interfaceBpush.onselect() {
	origInterfaceMode = 0;
}


// Corners: 0
handler corner0push.onselect() {
	widgetCornerRadius = 0;
}


// Corners: 4
handler corner4push.onselect() {
	widgetCornerRadius = 4;
}


// Corners: 8
handler corner8push.onselect() {
	widgetCornerRadius = 8;
}


// Save button
handler prefsSaveBtn.onselect() {
	saveMainPreferences();
	mainForm.load();
}


// Back button
handler prefsBackBtn.onselect() {
	mainForm.load();
}


handler preferencesForm.onpenup() {
	if (colorDepth > 4)
		colorsBmp.visible = true;
}


handler prefsDebugBtn.onselect() {
	debugModalForm.domodal();
}
