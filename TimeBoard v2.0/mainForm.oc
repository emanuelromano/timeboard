void composeBackgroundBuffer() {
	// Widget corner radius correction
	if (widgetCornerRadius == 0)
		auxWidgetCornerRadius = 1;
	else
		auxWidgetCornerRadius = widgetCornerRadius;
	
	mainBuffer.begin();
	
	// Draw background
	mainBuffer.fg(backgroundColorIndex);
	mainBuffer.rect(clrFG, mainForm.x, mainForm.y, mainForm.w, mainForm.h, 0);
	
	// For interfaceMode = 0 & 1:
	if (showWidget1) {		
		// Main rectangle
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, startX1, startY1, startX1+widgetW+1, startY1+widgetH+1, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, startX1+1, startY1+1, startX1+widgetW-1, startY1+widgetH-1, auxWidgetCornerRadius-1);
		
		if (interfaceMode == 1) {
			// Big widget pannel text
			mainBuffer.begin();
			mainBuffer.textColor(highlightColorIndex);
			mainBuffer.bg(widgetColorIndex);
			mainBuffer.font(fntBold);
			mainBuffer.textAlign(22);
			mainBuffer.text(clrText, mainForm.w-14, mainForm.y+widgetH+1, "TimeBoard");
			mainBuffer.end();
		}
	}
	
	// For interfaceMode = 0:
	if (showWidget2) {
		// Main rectangle
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, startX2, startY2, startX2+widgetW+1, startY2+widgetH+1, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, startX2+1, startY2+1, startX2+widgetW-1, startY2+widgetH-1, auxWidgetCornerRadius-1);
	}
	
	if (showWidget3) {
		// Main rectangle
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, startX3, startY3, startX3+widgetW+1, startY3+widgetH+1, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, startX3+1, startY3+1, startX3+widgetW-1, startY3+widgetH-1, auxWidgetCornerRadius-1);
	}
	
	if (showWidget4) {
		// Main rectangle
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, startX4, startY4, startX4+widgetW+1, startY4+widgetH+1, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, startX4+1, startY4+1, startX4+widgetW-1, startY4+widgetH-1, auxWidgetCornerRadius-1);
	}
	
	mainBuffer.end();
}


void composeWidgetsBuffer() {
	if (showWidget1)
		if (interfaceMode == 0)
			analogClockWidget(startX1, startY1);
		if (interfaceMode == 1)
			analogClockWidget2(startX1, startY1);
	
	if (showWidget2) digitalClockWidget(startX2, startY2);
	if (showWidget3) calendarWidget(startX3, startY3);
	if (showWidget4) batteryWidget(startX4, startY4);
}


handler mainForm.onopen() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
	
	setMainPreferences();
	
	date.now();
	year = date.year;
	month = date.month;
	day = date.day;
	weekday = date.weekday;

	hours = date.hour;
	minutes = date.min;
	seconds = date.sec;
	
	charge = battery(false);
	
	// Corner radius for font segments
	fontRadius = 2;
	
	saveMainPreferences();
	
	timer(1);
}


handler mainForm.ondraw() {
	showWidget1 = false;
	showWidget2 = false;
	showWidget3 = false;
	showWidget4 = false;
	
	bigUI = false;
	
	if (mainForm.h > 160) {
		// Portrait mode
		showWidget1 = true;
		
		interfaceMode = 0; // Force interfaceMode to 0 for fullscreen modes
		bigUI  = true;
		
		widgetW = 144;
		widgetH = 154;
		
		miniPanelX1 = 14;
		miniPanelY1 = 173;
		
		miniPanelX2 = 61;
		miniPanelY2 = 173;
		
		miniPanelX3 = 108;
		miniPanelY3 = 173;
		
		miniPanelW = 38;
		miniPanelH = 38;
		
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the bottom
		orientation = "P"; // Portrait
		drawAuxiliarPanel(orientation);
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else if (mainForm.w > 160) {
		// Landscape mode
		showWidget1 = true;
		
		interfaceMode = 0; // Force interfaceMode to 0 for fullscreen modes
		bigUI  = true;
		
		widgetW = 154;
		widgetH = 144;
		
		miniPanelX1 = 173;
		miniPanelY1 = 15;
		
		miniPanelX2 = 173;
		miniPanelY2 = 62;
		
		miniPanelX3 = 173;
		miniPanelY3 = 109;
		
		miniPanelW = 38;
		miniPanelH = 38;
		
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the side
		orientation = "L"; // Landscape
		drawAuxiliarPanel(orientation);
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else
	{
		// Normal mode (square display)
		interfaceMode = appPrefs[appPrefsPosition].interfaceMode;
		
		if (interfaceMode == 1) {
			showWidget1 = true;
			
			widgetW = 144;
			widgetH = 89;
			
			miniPanelX1 = 14;
			miniPanelY1 = 108;
			
			miniPanelX2 = 61;
			miniPanelY2 = 108;
			
			miniPanelX3 = 108;
			miniPanelY3 = 108;
			
			miniPanelW = 38;
			miniPanelH = 38;
			
			composeBackgroundBuffer();
			composeWidgetsBuffer();
			
			orientation = "N"; // Normal (square)
			drawAuxiliarPanel(orientation);
			
			// Mini widgets
			miniDigitalClockWidget(miniPanelX1, miniPanelY1);
			miniCalendarWidget(miniPanelX2, miniPanelY2);
			miniBatteryWidget(miniPanelX3, miniPanelY3);
		}
		else
		{
			showWidget1 = true;
			showWidget2 = true;
			showWidget3 = true;
			showWidget4 = true;
			
			widgetW = 70;
			widgetH = 70;
			
			composeBackgroundBuffer();
			composeWidgetsBuffer();
		}
	}
	
	// Draw mainBuffer
	drawMainBuffer();
}


handler mainForm.ontimer() {
	date.now();
	seconds = date.sec;
	
	if (!mainForm.obscured && seconds != lastSecond) {
		year = date.year;
		month = date.month;
		day = date.day;
		weekday = date.weekday;
	
		hours = date.hour;
		minutes = date.min;
		
		charge = battery(false);
		
		// Widgets
		if (showWidget1) {
			if (interfaceMode == 0) updateClockHands();
			if (interfaceMode == 1) updateClockHands2();
		}
		
		if (showWidget2)
			digitalClockWidget(startX2, startY2);
		else
			miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		
		if (day != lastDay) {
    		if (showWidget3)
        		calendarWidget(startX3, startY3);
    		else
        		miniCalendarWidget(miniPanelX2, miniPanelY2);
		}
		
		if (charge != lastCharge) {
    		if (showWidget4)
        		batteryWidget(startX4, startY4);
    		else
        		miniBatteryWidget(miniPanelX3, miniPanelY3);
		}
		
		// Draw mainBuffer
		drawMainBuffer();
		
		lastDay = day;
		lastCharge = charge;
	}
	
	lastSecond = seconds;
	timer(20);
}


handler mainForm.onresize() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
}


handler mainForm.onpenup() {
	int penX = e.x,
		penY = e.y;
	
	/* // Widget 1
	if (penX >= startX1 && penX <= startX1 + widgetW && penY >= startY1 && penY <= startY1 + widgetH) {
		//alert("Widget 1");
	}
	
	// Widget 2
	if (penX >= startX2 && penX <= startX2 + widgetW && penY >= startY2 && penY <= startY2 + widgetH) {
		//alert("Widget 2");
	}
	
	// Widget 3
	if (penX >= startX3 && penX <= startX3 + widgetW && penY >= startY3 && penY <= startY3 + widgetH) {
		//alert("Widget 3");
	}
	
	// Widget 4
	if (penX >= startX4 && penX <= startX4 + widgetW && penY >= startY4 && penY <= startY4 + widgetH) {
		//alert("Widget 4");
	} */
	
	if (interfaceMode == 1 || bigUI) {
		if (penX >= miniPanelX3 && penX <= miniPanelX3 + miniPanelW && penY >= miniPanelY3 && penY <= miniPanelY3 + miniPanelH) {
			if (!showBattPercentage)
				showBattPercentage = true;
			else
				showBattPercentage = false;
			
			miniBatteryWidget(miniPanelX3, miniPanelY3);
			drawMainBuffer();
		}
	}
}


// MENU OPTIONS
// Preferences
handler mainOptionsPrefs.onselect() {
	preferencesForm.load();
}


// TBTS: Checks if TimeBoard Time Service is installed
handler mainFuncTBTS.onselect() {
	if (isTBTSInstalled()) {
		launchCustomString("TBTS", launchCodeOrbCAppWithArgs, "TIMEBOARD");
	}
	else {
		alert("TimeBoard Time Service (TBTS) is not installed.");
	}
}


// Help
handler mainOptionsHelp.onselect() {
	helpForm.load();
}


// About
handler mainOptionsAbout.onselect() {
	alert("TimeBoard v" + TimeBoard.version + " (Prototype)\n@coloraturip\n©2026");
}
