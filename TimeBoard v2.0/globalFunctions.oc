// Set main preferences on global variables
void setMainPreferences() {
	// Set UI colors
	backgroundColorIndex = appPrefs[appPrefsPosition].backgroundColorIndex;	
	widgetColorIndex = appPrefs[appPrefsPosition].widgetColorIndex;	
	shadowColorIndex = appPrefs[appPrefsPosition].shadowColorIndex;	
	highlightColorIndex = appPrefs[appPrefsPosition].highlightColorIndex;	
	mainColorIndex = appPrefs[appPrefsPosition].mainColorIndex;
	
	// Analog clock colors
	acBackgroundColorIndex = appPrefs[appPrefsPosition].acBackgroundColorIndex;
	acDotsColorIndex = appPrefs[appPrefsPosition].acDotsColorIndex;
	acNumbersColorIndex = appPrefs[appPrefsPosition].acNumbersColorIndex;
	acHourMinColorIndex = appPrefs[appPrefsPosition].acHourMinColorIndex;
	acSecondsColorIndex = appPrefs[appPrefsPosition].acSecondsColorIndex;
	acCenterColorIndex = appPrefs[appPrefsPosition].acCenterColorIndex;
	
	batteryColorIndex = appPrefs[appPrefsPosition].batteryColorIndex;
	battery40ColorIndex = appPrefs[appPrefsPosition].battery40ColorIndex;
	battery20ColorIndex = appPrefs[appPrefsPosition].battery20ColorIndex;
	batteryEmptyColorIndex = appPrefs[appPrefsPosition].batteryEmptyColorIndex;
	
	// Set other parameters
	debugFlag = appPrefs[appPrefsPosition].debugFlag;
	origInterfaceMode = interfaceMode = appPrefs[appPrefsPosition].interfaceMode;
	widgetCornerRadius = appPrefs[appPrefsPosition].widgetCornerRadius;
	acNumbers = appPrefs[appPrefsPosition].acNumbers;
	acCircle = appPrefs[appPrefsPosition].acCircle;
}


// Save main preferences from global variables
bool saveMainPreferences() {	
	// B/W screens (1-bit)
	appPrefs[0].debugFlag = debugFlag;
	appPrefs[0].interfaceMode = origInterfaceMode;
	appPrefs[0].widgetCornerRadius = widgetCornerRadius;
	appPrefs[0].acNumbers = acNumbers;
	appPrefs[0].acCircle = true;
	
	// Grayscale screens (2-bit)
	appPrefs[1].debugFlag = debugFlag;
	appPrefs[1].interfaceMode = origInterfaceMode;
	appPrefs[1].widgetCornerRadius = widgetCornerRadius;
	appPrefs[1].acNumbers = acNumbers;
	appPrefs[1].acCircle = true;
	
	// Grayscale screens (4-bit)
	appPrefs[2].debugFlag = debugFlag;
	appPrefs[2].interfaceMode = origInterfaceMode;
	appPrefs[2].widgetCornerRadius = widgetCornerRadius;
	appPrefs[2].acNumbers = acNumbers;
	appPrefs[2].acCircle = true;
	
	// Color screens (8-bit & 16-bit)
	appPrefs[3].debugFlag = debugFlag;
	appPrefs[3].interfaceMode = origInterfaceMode;
	appPrefs[3].widgetCornerRadius = widgetCornerRadius;
	appPrefs[3].acNumbers = acNumbers;
	appPrefs[3].acCircle = acCircle;
	
	// Specific theme settings for color themes
	if (colorDepth > 4) {
		appPrefs[3].backgroundColorIndex = backgroundColorIndex;
		appPrefs[3].widgetColorIndex = widgetColorIndex;
		appPrefs[3].shadowColorIndex = shadowColorIndex;
		appPrefs[3].highlightColorIndex = highlightColorIndex;
		appPrefs[3].mainColorIndex = mainColorIndex;
		
		appPrefs[3].acBackgroundColorIndex = acBackgroundColorIndex;
		appPrefs[3].acDotsColorIndex = acDotsColorIndex;
		appPrefs[3].acNumbersColorIndex = acNumbersColorIndex;
		appPrefs[3].acHourMinColorIndex = acHourMinColorIndex;
		appPrefs[3].acSecondsColorIndex = acSecondsColorIndex;
		appPrefs[3].acCenterColorIndex = acCenterColorIndex;
		
		appPrefs[3].batteryColorIndex = batteryColorIndex;
		appPrefs[3].battery40ColorIndex = battery40ColorIndex;
		appPrefs[3].battery20ColorIndex = battery20ColorIndex;
		appPrefs[3].batteryEmptyColorIndex = batteryEmptyColorIndex;
	}
	
	return prefs.set(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


// Delete preferences and set default ones
void deletePrefs() {
	prefs.del(TimeBoard.creator, true);
	setDefaultPrefs();
}


// TimeBoard handler: Save preferences on app stop
handler TimeBoard.onstop() {
	saveMainPreferences();
}


void drawAuxiliarPanel(string orientation) {
	mainBuffer.begin();
	
	if (orientation == "P") { // PORTRAIT
		// Main rectangle
		if (widgetCornerRadius == 0)
			auxWidgetCornerRadius = 1;
		else
			auxWidgetCornerRadius = widgetCornerRadius;
		
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, mainForm.x+8, mainForm.h-miniPanelH-21, mainForm.w-7, mainForm.h-7, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, mainForm.x+9, mainForm.h-miniPanelH-20, mainForm.w-9, mainForm.h-9, auxWidgetCornerRadius-1);
		
		// Line separators
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.line(clrFG, mainForm.x+56, mainForm.h-miniPanelH-15, mainForm.x+56, mainForm.h-14);
		mainBuffer.line(clrFG, mainForm.w-57, mainForm.h-miniPanelH-15, mainForm.w-57, mainForm.h-14);
		
		// TESTING PANELS
		if (debugFlag) {
			mainBuffer.fg(mainColorIndex);
			mainBuffer.frame(clrFG, miniPanelX1, miniPanelY1, miniPanelX1+miniPanelW, miniPanelY1+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX2, miniPanelY2, miniPanelX2+miniPanelW, miniPanelY2+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX3, miniPanelY3, miniPanelX3+miniPanelW, miniPanelY3+miniPanelH, 0, 1);
		}
	}
	
	if (orientation == "L") { // LANDSCAPE	
		// Main rectangle
		if (widgetCornerRadius == 0)
			auxWidgetCornerRadius = 1;
		else
			auxWidgetCornerRadius = widgetCornerRadius;
		
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, mainForm.w-miniPanelH-21, 8, mainForm.w-7, mainForm.h-7, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, mainForm.w-miniPanelH-20, 9, mainForm.w-9, mainForm.h-9, auxWidgetCornerRadius-1);
				
		// Line separators
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.line(clrFG, mainForm.w-miniPanelH-15, mainForm.h-56, mainForm.w-14, mainForm.h-56);
		mainBuffer.line(clrFG, mainForm.w-miniPanelH-15, mainForm.y+57, mainForm.w-14, mainForm.y+57);
		
		// TESTING PANELS
		if (debugFlag) {
			mainBuffer.fg(mainColorIndex);
			mainBuffer.frame(clrFG, miniPanelX1, miniPanelY1, miniPanelX1+miniPanelW, miniPanelY1+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX2, miniPanelY2, miniPanelX2+miniPanelW, miniPanelY2+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX3, miniPanelY3, miniPanelX3+miniPanelW, miniPanelY3+miniPanelH, 0, 1);
		}
	}
	
	if (orientation == "N") { // NORMAL	
		// Main rectangle
		if (widgetCornerRadius == 0)
			auxWidgetCornerRadius = 1;
		else
			auxWidgetCornerRadius = widgetCornerRadius;
		
		mainBuffer.fg(shadowColorIndex);
		mainBuffer.rect(clrFG, mainForm.x+8, mainForm.h-miniPanelH-21, mainForm.w-7, mainForm.h-7, widgetCornerRadius);
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, mainForm.x+9, mainForm.h-miniPanelH-20, mainForm.w-9, mainForm.h-9, auxWidgetCornerRadius-1);
		
		// Line separators
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.line(clrFG, mainForm.x+56, mainForm.h-miniPanelH-15, mainForm.x+56, mainForm.h-14);
		mainBuffer.line(clrFG, mainForm.w-57, mainForm.h-miniPanelH-15, mainForm.w-57, mainForm.h-14);
		
		// TESTING PANELS
		if (debugFlag) {
			mainBuffer.fg(mainColorIndex);
			mainBuffer.frame(clrFG, miniPanelX1, miniPanelY1, miniPanelX1+miniPanelW, miniPanelY1+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX2, miniPanelY2, miniPanelX2+miniPanelW, miniPanelY2+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX3, miniPanelY3, miniPanelX3+miniPanelW, miniPanelY3+miniPanelH, 0, 1);
		}
	}
	
	mainBuffer.end();
}


void splitDateDigits(int day) {
	dayDigit1 = day / 10;
	dayDigit2 = day % 10;
}


void splitTimeDigits() {
	// Hours
	hourDigit1 = hours / 10;
	hourDigit2 = hours % 10;

	// Minutes
	minuteDigit1 = minutes / 10;
	minuteDigit2 = minutes % 10;

	// Seconds
	secondDigit1 = seconds / 10;
	secondDigit2 = seconds % 10;
}


void drawSegment(int x1, int y1,
				 int x2, int y2,
				 int radius)
{
	mainBuffer.rect(clrFG, x1, y1, x2, y2, radius);
}


void drawDigit(int number,
			   int digitW,
			   int digitH,
			   int digitX,
			   int digitY,
			   int radius,
			   int segThickness)
{
	bool segment1 = false,
		 segment2 = false,
		 segment3 = false,
		 segment4 = false,
		 segment5 = false,
		 segment6 = false,
		 segment7 = false,
		 segmentA = false,
		 segmentB = false;
	
	int midY,
		midYCorrection,
		rightX;
	
	midY = digitH / 2;
	midYCorrection = 2;
	rightX = digitW - segThickness;
	
	switch (number) {
		case 0:
			segment1 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 1:
			segment3 = true;
			segmentA = true;
			segmentB = true;
			break;
		case 2:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment7 = true;
			break;
		case 3:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			break;
		case 4:
			segment2 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			break;
		case 5:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment5 = true;
			segment6 = true;
			break;
		case 6:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 7:
			segment1 = true;
			segment4 = true;
			segment5 = true;
			break;
		case 8:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 9:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			break;
	}
	
	// ERASE OLD DIGIT
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.rect(clrBG, digitX, digitY, digitX+digitW, digitY+digitH, 0);
	
	// DRAW NEW SEGMENTS
	// -------- Horizontal --------
	if (segment1) {
		drawSegment(digitX,
					digitY,
					digitX + digitW,
					digitY + segThickness,
					radius);
	}
	
	if (segment2) {
		drawSegment(digitX,
					digitY + midY - (segThickness / 2),
					digitX + digitW,
					digitY + midY + (segThickness / 2),
					radius);
	}
	
	if (segment3) {
		drawSegment(digitX,
					digitY + digitH - segThickness,
					digitX + digitW,
					digitY + digitH,
					radius);
	}
	
	// -------- Vertical right --------
	if (segment4) {
		drawSegment(digitX + rightX,
					digitY,
					digitX + digitW,
					digitY + midY + midYCorrection,
					radius);
	}
	
	if (segment5) {
		drawSegment(digitX + rightX,
					digitY + midY - midYCorrection,
					digitX + digitW,
					digitY + digitH,
					radius);
	}
	
	// -------- Vertical left --------
	if (segment6) {
		drawSegment(digitX,
					digitY,
					digitX + segThickness,
					digitY + midY + midYCorrection,
					radius);
	}
	
	if (segment7) {
		drawSegment(digitX,
					digitY + midY - midYCorrection,
					digitX + segThickness,
					digitY + digitH,
					radius);
	}
	
	// -------- Number 1 --------
	if (segmentA) {
		drawSegment(digitX,
					digitY,
					digitX + (digitW / 2),
					digitY + segThickness,
					radius);
	}
	
	if (segmentB) {
		drawSegment(digitX + (digitW / 2) - (segThickness / 2),
					digitY,
					digitX + (digitW / 2) + (segThickness / 2),
					digitY + digitH,
					radius);
	}
}


// Sine calculation
int calcSin(int index) {
	if (index < 0)
		index += 720;
	
	if (index >= 720)
		index -= 720;
	
	return sinTable[index];
}


// Cosine calculation
int calcCos(int index) {
    return calcSin(index + 180);
}


// Checks if TimeBoard Time Service is installed
bool isTBTSInstalled() {
	DatabaseMgr dbMgr;
	string appName;
	
	appName = dbMgr.dbenum(true, "appl", "TBTS");
	
	if (appName != "")
		return true;
	
	return false;
}


// Draw mainBuffer
void drawMainBuffer() {
	int nw, nh;
	
	draw.nbegin();
	nw = draw.nw;
	nh = draw.nh;
	draw.end();
	
	draw.begin();
	draw.draw(mainBuffer, 0, 0);
	
	if (debugFlag) {
		draw.text(clrFG, 0, 0, " DEBUG MODE");
		
		draw.text(clrFG, 0, 11,
			" Form W: " + mainForm.w + " / H: " + mainForm.h);
		
		draw.text(clrFG, 0, 22,
			" Native W: " + nw + " / H: " + nh);
		
		draw.text(clrFG, 0, 33,
			" InterfaceMode: " + interfaceMode + " / BigUI: " + bigUI);
			
		draw.text(clrFG, 0, 44,
			" OrigInterfaceMode: " + origInterfaceMode);	
	}
	draw.end();
}
