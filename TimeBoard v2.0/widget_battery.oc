void drawBatteryDots(int startX, int startY, int widW, int widH, int dotRadius, int ringRadius, int charge) {
	int centerX, centerY,
		activeDots,
		i, x, y,
		battColorIndex,
		index;
	
	centerX = startX + (widW / 2);
	centerY = startY + (widH / 2);
	
	activeDots = charge / 10;
	
	if (activeDots > 10)
		activeDots = 10;
	
	if (activeDots < 0)
		activeDots = 0;
	
	// Battery color
	if (colorDepth > 4) {
		if (charge >= 50)
			// Green
			battColorIndex = batteryColorIndex;
		else if (charge >= 21)
			// Orange
			battColorIndex = battery40ColorIndex;
		else
			// Red
			battColorIndex = battery20ColorIndex;
	}
	else
	{
		battColorIndex = batteryColorIndex;
	}
	
	// Draw battery dots
	index = 0;
	for (i = 0; i < 10; i++) {
		index = i * 72;
		
		x = centerX + roundCoord(
    		(float)calcSin(index) * ringRadius / 512);
		
		y = centerY - roundCoord(
    		(float)calcCos(index) * ringRadius / 512);
		
		if (i < activeDots) {
			mainBuffer.fg(battColorIndex);
			
			mainBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
		else
		{
			if (colorDepth > 4) {
				mainBuffer.fg(batteryEmptyColorIndex); // Color discharged grey
				
				mainBuffer.rect(
				clrFG,
				x - dotRadius,
				y - dotRadius,
				x + dotRadius,
				y + dotRadius,
				dotRadius);
			}
			else
			{
				if (colorDepth == 1) {
					mainBuffer.fg(batteryEmptyColorIndex); // B/W discharged empty circles
					
					mainBuffer.frame(
					clrFG,
					x - (dotRadius-1),
					y - (dotRadius-1),
					x + (dotRadius),
					y + (dotRadius),
					dotRadius,
					1);
				}
				else
				{
					mainBuffer.fg(batteryEmptyColorIndex); // Gray discharged grey
					
					mainBuffer.rect(
					clrFG,
					x - dotRadius,
					y - dotRadius,
					x + dotRadius,
					y + dotRadius,
					dotRadius);
				}
			}
		}
	}
}


void batteryWidget(int startX, int startY) {
	int dotRadius = 4,
		ringRadius = 18,
		
		iconX = startX + 7,
		iconY = startY + 55,
		
		digitY = startY + 52;
	
	mainBuffer.begin();
	// Battery dots
	drawBatteryDots(startX, startY, widgetW, widgetH-13, dotRadius, ringRadius, charge);
	
	// Battery icon
	mainBuffer.fg(mainColorIndex);
	mainBuffer.frame(clrFG, iconX, iconY, iconX+15, iconY+8, 2, 1);
	mainBuffer.line(clrFG, iconX+16, iconY+2, iconX+16, iconY+5);
	
	mainBuffer.fg(highlightColorIndex);
	mainBuffer.rect(clrFG, iconX+1, iconY+1, iconX+14, iconY+7, 1);
	
	// Battery percentage
	if (colorDepth > 4 || colorDepth == 1)
		mainBuffer.textColor(mainColorIndex);
	else
		mainBuffer.textColor(highlightColorIndex);
	
	mainBuffer.textAlign(02);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+65, digitY, "   "+charge+"%");
	mainBuffer.end();
}


void miniBatteryWidget(int startX, int startY) {
	int dotRadius = 3,
		ringRadius = 16,
		
		iconX = startX + 11,
		iconY = startY + 15,
		
		digitX = startX + (miniPanelW / 2),
		digitY = startY + (miniPanelH / 2);
	
	mainBuffer.begin();
	
	if (showBattPercentage) {
		// Battery percentage
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, iconX-3, iconY-2, iconX+20, iconY+10, 1);
	
		mainBuffer.textColor(mainColorIndex);
		mainBuffer.textAlign(11);
		mainBuffer.bg(widgetColorIndex);
		mainBuffer.font(fntStandard);
		
		// Charge
		if (charge == 100)
			mainBuffer.text(clrText, digitX-1, digitY-2, "  " + charge + "% ");
		else
			mainBuffer.text(clrText, digitX, digitY-2, "  " + charge + "% ");
	}
	else
	{
		// Battery icon
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG, iconX-3, iconY-2, iconX+20, iconY+10, 1);
		mainBuffer.fg(mainColorIndex);
		mainBuffer.frame(clrFG, iconX, iconY, iconX+15, iconY+8, 2, 1);
		mainBuffer.line(clrFG, iconX+16, iconY+2, iconX+16, iconY+5);
		
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.rect(clrFG, iconX+1, iconY+1, iconX+14, iconY+7, 1);
	}
	
	// Battery dots
	drawBatteryDots(startX, startY, miniPanelW, miniPanelH, dotRadius, ringRadius, charge);
	mainBuffer.end();
}
