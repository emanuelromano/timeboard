/* ------------------------------------------------------------
	TimeBoard - A new clock app for Palm OS
	
	Written by @coloraturip
	
	VERSION 2.0.0 - Supports Palm OS 3.5 or newer
	
	Project started on March 13th, 2025
--------------------------------------------------------------- */

Preferences prefs;
const int numberOfPrefs = 4;
int colorDepth,
	appPrefsPosition;	// Determines which preferences will be used
						// according to the device's screen color depth.
						// 0: B/W screens (1-bit)
						// 1: Grayscale screens (2-bit)
						// 2: Grayscale screens (4-bit)
						// 3: Color screens (8-bit & 16-bit)

struct AppPrefs {
	// Background color
	int backgroundColorIndex;
	// Foreground color on widgets
	int widgetColorIndex;
	// Shadows for widgets
	int shadowColorIndex;
	// Highlight color on widget elements
	int highlightColorIndex;
	// Base color on widget elements
	int mainColorIndex;
	
	// Analog clock background
	int acBackgroundColorIndex;
	// Analog clock dots
	int acDotsColorIndex;
	// Analog clock numbers
	int acNumbersColorIndex;
	// Analog clock hour/min hands
	int acHourMinColorIndex;
	// Analog clock seconds hand 
	int acSecondsColorIndex;
	// Analog clock center
	int acCenterColorIndex;
	
	// Battery colors
	int batteryColorIndex;
	int battery40ColorIndex;
	int battery20ColorIndex;
	int batteryEmptyColorIndex;
	
	// Other preferences
	bool debugFlag;
	int interfaceMode;
	int widgetCornerRadius;
	bool acNumbers;
	bool acCircle;
};

AppPrefs appPrefs[numberOfPrefs];


// Getting saved preferences
// Returns false if there are no stored preferences
bool getPrefs() {
	return prefs.get(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


// Set default preferences
bool setDefaultPrefs() {
	bool debugFlag = false,
		acNumbers = true,	// Show numbers or lines in Analog Clock:
							// true / numbers
							// false / lines
		acCircle = true;	// Show circle around Analog Clock
	int interfaceMode = 1,
		widgetCornerRadius = 4; // 0-4-8 pixels
	
	// 0: B/W screens (1-bit)
	appPrefs[0].backgroundColorIndex = 0;
	appPrefs[0].widgetColorIndex = 0;
	appPrefs[0].shadowColorIndex = 1;
	appPrefs[0].highlightColorIndex = 1;
	appPrefs[0].mainColorIndex = 1;
	
	appPrefs[0].acBackgroundColorIndex = 0;
	appPrefs[0].acDotsColorIndex = 1;
	appPrefs[0].acNumbersColorIndex = 1;
	appPrefs[0].acHourMinColorIndex = 1;
	appPrefs[0].acSecondsColorIndex = 1;
	appPrefs[0].acCenterColorIndex = 1;
	
	appPrefs[0].batteryColorIndex = 1;
	appPrefs[0].battery40ColorIndex = 1;
	appPrefs[0].battery20ColorIndex = 1;
	appPrefs[0].batteryEmptyColorIndex = 0;
	
	appPrefs[0].debugFlag = debugFlag;
	appPrefs[0].interfaceMode = interfaceMode;
	appPrefs[0].widgetCornerRadius = widgetCornerRadius;
	appPrefs[0].acNumbers = acNumbers;
	appPrefs[0].acCircle = true;
	
	// 1: Grayscale screens (2-bit)
	appPrefs[1].backgroundColorIndex = 1;
	appPrefs[1].widgetColorIndex = 0;
	appPrefs[1].shadowColorIndex = 3;
	appPrefs[1].highlightColorIndex = 2;
	appPrefs[1].mainColorIndex = 3;
	
	appPrefs[1].acBackgroundColorIndex = 0;
	appPrefs[1].acDotsColorIndex = 2;
	appPrefs[1].acNumbersColorIndex = 3;
	appPrefs[1].acHourMinColorIndex = 3;
	appPrefs[1].acSecondsColorIndex = 2;
	appPrefs[1].acCenterColorIndex = 2;
	
	appPrefs[1].batteryColorIndex = 2;
	appPrefs[1].battery40ColorIndex = 2;
	appPrefs[1].battery20ColorIndex = 2;
	appPrefs[1].batteryEmptyColorIndex = 1;
	
	appPrefs[1].debugFlag = debugFlag;
	appPrefs[1].interfaceMode = interfaceMode;
	appPrefs[1].widgetCornerRadius = widgetCornerRadius;
	appPrefs[1].acNumbers = acNumbers;
	appPrefs[1].acCircle = true;
	
	// 2: Grayscale screens (4-bit)
	appPrefs[2].backgroundColorIndex = 5;
	appPrefs[2].widgetColorIndex = 0;
	appPrefs[2].shadowColorIndex = 12;
	appPrefs[2].highlightColorIndex = 9;
	appPrefs[2].mainColorIndex = 15;
	
	appPrefs[2].acBackgroundColorIndex = 0;
	appPrefs[2].acDotsColorIndex = 10;
	appPrefs[2].acNumbersColorIndex = 15;
	appPrefs[2].acHourMinColorIndex = 15;
	appPrefs[2].acSecondsColorIndex = 10;
	appPrefs[2].acCenterColorIndex = 10;
	
	appPrefs[2].batteryColorIndex = 10;
	appPrefs[2].battery40ColorIndex = 9;
	appPrefs[2].battery20ColorIndex = 8;
	appPrefs[2].batteryEmptyColorIndex = 5;
	
	appPrefs[2].debugFlag = debugFlag;
	appPrefs[2].interfaceMode = interfaceMode;
	appPrefs[2].widgetCornerRadius = widgetCornerRadius;
	appPrefs[2].acNumbers = acNumbers;
	appPrefs[2].acCircle = true;
	
	// 3: Color screens (8-bit)
	appPrefs[3].backgroundColorIndex = 115;
	appPrefs[3].widgetColorIndex = 217;
	appPrefs[3].shadowColorIndex = 216;
	appPrefs[3].highlightColorIndex = 121;
	appPrefs[3].mainColorIndex = 0;
	
	appPrefs[3].acBackgroundColorIndex = 218;
	appPrefs[3].acDotsColorIndex = 224;
	appPrefs[3].acNumbersColorIndex = 0;
	appPrefs[3].acHourMinColorIndex = 0;
	appPrefs[3].acSecondsColorIndex = 121;
	appPrefs[3].acCenterColorIndex = 121;
	
	appPrefs[3].batteryColorIndex = 168;
	appPrefs[3].battery40ColorIndex = 116;
	appPrefs[3].battery20ColorIndex = 119;
	appPrefs[3].batteryEmptyColorIndex = 219;
	
	appPrefs[3].debugFlag = debugFlag;
	appPrefs[3].interfaceMode = interfaceMode;
	appPrefs[3].widgetCornerRadius = widgetCornerRadius;
	appPrefs[3].acNumbers = acNumbers;
	appPrefs[3].acCircle = acCircle;
	
	return prefs.set(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


handler TimeBoard.onstart() {
	int version = osver();
	
	// VALIDATION
	// Minimun OS version warning
	if (version < 50462720) {
    	alert("This version of TimeBoard requires Palm OS 3.5 or higher.\nApp will exit.");
    	TimeBoard.abort();
	}
	
	// Get color depth supported by device at the moment
	colorDepth = TimeBoard.getdepth();	
	switch (colorDepth) {
		case 1:
				appPrefsPosition = 0; // 0: B/W screens (1-bit)
				break;
		case 2:
				appPrefsPosition = 1; // 1: Grayscale screens (2-bit)
				break;
		case 4:
				appPrefsPosition = 2; // 2: Grayscale screens (4-bit)
				break;
		case 8:
				appPrefsPosition = 3; // 3: Color screens (8-bit)
				break;
		case 16:
				appPrefsPosition = 3; // 3: Color screens (16-bit)
				break;
		default:
				appPrefsPosition = 3; // 3: Color screens (16-bit)
				break;
	}
	
	// If there is no default prefs, set default prefs
	if (!getPrefs())
		setDefaultPrefs();
	
	// Load the main form
	mainForm.load();
}
