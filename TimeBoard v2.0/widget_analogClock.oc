// Draws seconds hand
void drawHand(int index,
			  int length,
			  int centerX,
			  int centerY,
			  int colorIndex)
{
	int x, y;
	
	x = centerX + roundCoord((float)calcSin(index) * length / 512);
	y = centerY - roundCoord((float)calcCos(index) * length / 512);
	
	// Draw line
	mainBuffer.fg(colorIndex);
	mainBuffer.line(clrFG, centerX, centerY, x, y);
}


// Draws hour/minutes hands
void drawWideHand(int index,
				int length,
				int baseWidth,
				int centerX,
				int centerY,
				int colorIndex)
{
	int tipX, tipY,
		baseX1, baseY1,
		baseX2, baseY2,
		baseIndex1, baseIndex2;
	
	// Base angles: +/- 48 degrees
	baseIndex1 = (index + 96) % 720;
	baseIndex2 = (index + 624) % 720; // -96 module 720
	
	// Tip
	tipX = centerX +
		roundCoord((float)calcSin(index) * length / 512);
	
	tipY = centerY -
		roundCoord((float)calcCos(index) * length / 512);
	
	// Base point 1
	baseX1 = centerX +
		roundCoord((float)calcSin(baseIndex1) * baseWidth / 512);
	
	baseY1 = centerY -
		roundCoord((float)calcCos(baseIndex1) * baseWidth / 512);
	
	// Base point 2
	baseX2 = centerX +
		roundCoord((float)calcSin(baseIndex2) * baseWidth / 512);
	
	baseY2 = centerY -
		roundCoord((float)calcCos(baseIndex2) * baseWidth / 512);
	
	// Draw the triangular hand
	mainBuffer.fg(colorIndex);
	mainBuffer.line(clrFG, tipX, tipY, baseX1, baseY1);
	mainBuffer.line(clrFG, tipX, tipY, baseX2, baseY2);
}


void updateClockHandsA() {
	int i, x, y,
		axisXcorrection,
		circleRadius,
		newHourIndex,
		newMinuteIndex,
		newSecondIndex,
		baseWidth;
	
	// Clock/seconds parameters
	baseWidth = 4;
	axisXcorrection = 70;
	secondLength = 15;
	
	mainBuffer.begin();
	
	// Delete old hands
	drawHand(oldSecondIndex,
			secondLength,
			centerX + axisXcorrection,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	// Calculate new angle index	
	newHourIndex =
			(hours % 12) * 60 + minutes;
	newMinuteIndex =
			minutes * 12;
	newSecondIndex =
			seconds * 12;
		
	// Draw new hands
		drawHand(newSecondIndex,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex);
		
		drawWideHand(newHourIndex,
			 	hourLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawWideHand(newMinuteIndex,
			 	minuteLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
	
	// HOUR: Center
	mainBuffer.fg(acCenterColorIndex);
	mainBuffer.rect(clrFG,
		centerX - 4,
		centerY - 4,
		centerX + 5,
		centerY + 5,
		5);
	
	// Center for seconds
	mainBuffer.fg(acCenterColorIndex);
	mainBuffer.rect(clrFG,
					(centerX + axisXcorrection) - 3,
					centerY - 3,
					(centerX + axisXcorrection) + 4,
					centerY + 4,
					4);
	
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourIndex = newHourIndex;
	oldMinuteIndex = newMinuteIndex;
	oldSecondIndex = newSecondIndex;
}


void analogClockWidgetA(int startX, int startY) {
	int i,
		x, y,
		x1, y1,
		x2, y2,
		radius,
		innerRadius,
		outerRadius,
		circleRadius,
		minuteDotRadius,
		secDotRadius,
		secCircleRadius,
		clockXcorrection,
		secXcorrection,
		secondLength,
		index;
	string number;
	
	// Clock parameters
	clockXcorrection = 28;
	centerX = startX + (widgetW / 2) - clockXcorrection;
	centerY = startY + (widgetH / 2);
	
	radius = 31;
	minuteDotRadius = 38;
	circleRadius = 40;
	
	// Clock hands lenght
	hourLength = 19;
	minuteLength = 25;
	secondLength = 15;
	
	// Seconds parameters
	secXcorrection = 70;
	secCircleRadius = 20;
	secDotRadius = secondLength + 2;
	
	mainBuffer.begin();
	
	// Clock background
	mainBuffer.fg(acBackgroundColorIndex);
	mainBuffer.rect(clrFG,
			centerX - circleRadius,
			centerY - circleRadius,
			centerX + circleRadius + 1,
			centerY + circleRadius + 1,
			circleRadius);
	
	// Seconds background
	mainBuffer.fg(acBackgroundColorIndex);
	mainBuffer.rect(clrFG,
			(centerX + secXcorrection) - secCircleRadius,
			centerY - secCircleRadius,
			(centerX + secXcorrection) + secCircleRadius + 1,
			centerY + secCircleRadius + 1,
			secCircleRadius + 1);
	
	// Minutes dots
	index = 0;
	for (i = 0; i < 60; i++) {
    	index = i * 12;
		
    	x = centerX + roundCoord(
        	(float)calcSin(index) * minuteDotRadius / 512);
		
    	y = centerY - roundCoord(
        	(float)calcCos(index) * minuteDotRadius / 512);
    	
		mainBuffer.fg(acDotsColorIndex);
		mainBuffer.pixel(clrFG, x, y);
	}
	
	// Seconds dots
	index = 0;
	for (i = 0; i < 12; i++) {
    	index = i * 60;
		
    	x = (centerX + secXcorrection) + roundCoord(
        	(float)calcSin(index) * secDotRadius / 512);
		
    	y = centerY - roundCoord(
        	(float)calcCos(index) * secDotRadius / 512);
        
    	mainBuffer.fg(acDotsColorIndex);
    	mainBuffer.pixel(clrFG, x, y);
	}
	
	if (acNumbers) {
		// Clock numbers
		index = 0;
		for (i = 0; i < 12; i++) {
			index = i * 60;
			
			x = centerX + roundCoord(
    			(float)calcSin(index) * radius / 512);
			
			y = centerY - roundCoord(
    			(float)calcCos(index) * radius / 512) - 1;
			
			// 0 = 12 o'clock
			if (i == 0)
				number = "12";
			else
				number = "" + i;
			
			// Text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.font(fntStandard);
			mainBuffer.bg(acBackgroundColorIndex);
			mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
			innerRadius = circleRadius - 8;
    		outerRadius = circleRadius - 2;
			
    		index = i * 60;
			
			x1 = centerX + roundCoord(
    			(float)calcSin(index) * innerRadius / 512);
			
			y1 = centerY - roundCoord(
    			(float)calcCos(index) * innerRadius / 512);
			
			x2 = centerX + roundCoord(
    			(float)calcSin(index) * outerRadius / 512);
			
			y2 = centerY - roundCoord(
    			(float)calcCos(index) * outerRadius / 512);
    			
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(acCenterColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2, y2+1);
    		}
		}
	}
	
	if (acCircle) {
		// Clock circle
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						centerX - circleRadius,
						centerY - circleRadius,
						centerX + circleRadius + 1,
						centerY + circleRadius + 1,
						circleRadius,
						1);
		
		// Seconds circle
		mainBuffer.frame(clrFG,
						(centerX + secXcorrection) - secCircleRadius,
						centerY - secCircleRadius,
						(centerX + secXcorrection) + secCircleRadius + 1,
						centerY + secCircleRadius + 1,
						secCircleRadius + 1,
						1);
	}
	
	mainBuffer.end();
	
	updateClockHandsA();
}


void updateClockHandsB(int mode) {
	int i,
		x, y,
		circleRadius,
		newHourIndex,
		newMinuteIndex,
		newSecondIndex,
		baseWidth;
	
	if (mode == 0)
		baseWidth = 3; // For Interface mode B
	else
		baseWidth = 2; // For miniAnalogClockWidget
	
	mainBuffer.begin();
	
	// Delete old hands
	drawHand(oldSecondIndex,
			secondLength,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	// Calculate new angle index	
	newHourIndex =
			(hours % 12) * 60 + minutes;
	newMinuteIndex =
			minutes * 12;
	newSecondIndex =
			seconds * 12;
	
	// Draw new hands
	drawWideHand(newHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acHourMinColorIndex);
	
	drawWideHand(newMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acHourMinColorIndex);
	
	drawHand(newSecondIndex,
			secondLength,
			centerX,
			centerY,
			acSecondsColorIndex);
	
	// Hand centre circle
	if (mode == 0) {
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourIndex = newHourIndex;
	oldMinuteIndex = newMinuteIndex;
	oldSecondIndex = newSecondIndex;
}


void analogClockWidgetB(int startX, int startY) {
	int i,
		x, y,
		x1, y1,
		x2, y2,
		radius,
		innerRadius,
		outerRadius,
		circleSeparation,
		secondDotRadius,
		index,
		auxiliarSize;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	// Clock parameters
	radius = 25;
	circleSeparation = 31;
	innerRadius = circleSeparation - 5;
	outerRadius = circleSeparation - 2;
	
	// Hands lenght
	hourLength = 15;
	minuteLength = 20;
	secondLength = 20;
	
	mainBuffer.begin();
	
	// Clock background
	mainBuffer.fg(acBackgroundColorIndex);
	mainBuffer.rect(clrFG,
			centerX-circleSeparation,
			centerY-circleSeparation,
			centerX+circleSeparation,
			centerY+circleSeparation,
			circleSeparation);
	
	// Clock numbers
	index = 0;
	if (acNumbers) {
		for (i = 0; i < 12; i++) {
			index = i * 60;
			
			x = centerX + roundCoord(
    			(float)calcSin(index) * radius / 512);
			
			y = centerY - roundCoord(
    			(float)calcCos(index) * radius / 512) - 1;
			
			// 0 = 12 o'clock
			if (i == 0)
				number = "12";
			else
				number = "" + i;
					
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bg(acBackgroundColorIndex);
			
			// Font size
			mainBuffer.font(fntStandard);
    		mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
    		index = i * 60;
			
			x1 = centerX + roundCoord(
    			(float)calcSin(index) * innerRadius / 512);
			
			y1 = centerY - roundCoord(
    			(float)calcCos(index) * innerRadius / 512);
			
			x2 = centerX + roundCoord(
    			(float)calcSin(index) * outerRadius / 512);
			
			y2 = centerY - roundCoord(
    			(float)calcCos(index) * outerRadius / 512);
    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(acCenterColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2);
    		}
    		else if (i == 3 && widgetW == 70) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2, y2+1);
    		}
    		else
    		{
				mainBuffer.fg(acDotsColorIndex);
				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	// Circle around clock
	if (acCircle) {
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						centerX - circleSeparation,
						centerY - circleSeparation,
						centerX + circleSeparation,
						centerY + circleSeparation,
						circleSeparation,
						1);
	}
	else
	{
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.frame(clrFG,
						centerX - circleSeparation,
						centerY - circleSeparation,
						centerX + circleSeparation,
						centerY + circleSeparation,
						circleSeparation,
						1);
	}
	
	mainBuffer.end();
	
	updateClockHandsB(0);
}


void updateClockHandsBigUI() {
	int i, x, y,
		axisXcorrection = 0,
		circleRadius,
		newHourIndex,
		newMinuteIndex,
		newSecondIndex,
		index = 0,
		baseWidth = 4;
	
	// Widget adjustments according to screen size
	if (widgetW > 70) {		
		if (widgetH > widgetW) {
			axisXcorrection = 40;
			secondLength = 14;
		}
		else
		{
			if (bigUI && mainForm.w > 200) { // For Hi-Res Landscape mode
				axisXcorrection = 40;
				secondLength = 14;
			}
			else
			{
				axisXcorrection = 35;
				secondLength = 12;
			}
		}
	}
	
	mainBuffer.begin();
	
	// Delete old hands
	drawHand(oldSecondIndex,
			secondLength,
			centerX + axisXcorrection,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	drawWideHand(oldMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	// Calculate new angle index	
	newHourIndex =
			(hours % 12) * 60 + minutes;
	newMinuteIndex =
			minutes * 12;
	newSecondIndex =
			seconds * 12;
	
	// TimeBoard text on big widget
	mainBuffer.textColor(highlightColorIndex);
    mainBuffer.bg(acBackgroundColorIndex);
	mainBuffer.textAlign(11);
	mainBuffer.font(fntBold);
	mainBuffer.text(clrText, centerX, centerY-27, " TimeBoard");
	
	// Circle for seconds on BigUI
	if (acCircle) {
		// Background for seconds
		/*mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG,
						(centerX + axisXcorrection) - (secondLength + 3),
						centerY - (secondLength+3),
						(centerX + axisXcorrection) + (secondLength + 4),
						centerY + (secondLength+4),
						(secondLength+4));*/
		
		// Circle around seconds
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						(centerX + axisXcorrection) - (secondLength + 3),
						centerY - (secondLength+3),
						(centerX + axisXcorrection) + (secondLength + 4),
						centerY + (secondLength+4),
						(secondLength+4),
						1);
	}
	/*else
	{
		// Background for seconds
		mainBuffer.fg(widgetColorIndex);
		mainBuffer.rect(clrFG,
						(centerX + axisXcorrection) - (secondLength + 3),
						centerY - (secondLength+3),
						(centerX + axisXcorrection) + (secondLength + 4),
						centerY + (secondLength+4),
						(secondLength+4));
	}*/
	
	// 12 dots (every 5 seconds)
	circleRadius = secondLength + 2;
	for (i = 0; i < 12; i++) {
    	index = i * 60;
		
    	x = (centerX + axisXcorrection) + roundCoord(
        	(float)calcSin(index) * circleRadius / 512);
		
    	y = centerY - roundCoord(
        	(float)calcCos(index) * circleRadius / 512);
        
    	mainBuffer.fg(acDotsColorIndex);
		mainBuffer.pixel(clrFG, x, y);
	}
	
	// Draw new hands
	drawHand(newSecondIndex,
			secondLength,
			centerX + axisXcorrection,
			centerY,
			acSecondsColorIndex);
	
	// Center for seconds
	mainBuffer.fg(acCenterColorIndex);
	mainBuffer.rect(clrFG,
					(centerX + axisXcorrection) - 3,
					centerY - 3,
					(centerX + axisXcorrection) + 4,
					centerY + 4,
					4);
	
	drawWideHand(newHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acHourMinColorIndex);
	
	drawWideHand(newMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acHourMinColorIndex);
	
	// Hand centre circle size according to widget size
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 4,
			centerY - 4,
			centerX + 5,
			centerY + 5,
			5);
	
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourIndex = newHourIndex;
	oldMinuteIndex = newMinuteIndex;
	oldSecondIndex = newSecondIndex;
}


void analogClockWidgetBigUI(int startX, int startY) {
	int i,
		x, y,
		x1, y1,
		x2, y2,
		radius,
		innerRadius,
		outerRadius,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius,
		index,
		auxiliarSize;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	// Set radius based on widget size
	if (widgetH > widgetW) {
		radius = (widgetW / 2) - (widgetW / 2) * 0.26;
		
		// Radius fot circle background, circle and seconds dots
		circleSeparation = (widgetW / 2) - 5;
		circleCornerRadius = (widgetW / 2) - 5;
		secondDotRadius = (widgetW / 2) - 8;
		
		// Hands lenght
		hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
		minuteLength = (widgetW / 2) - (widgetW / 2) * 0.41;
		secondLength = (widgetW / 2) - (widgetW / 2) * 0.41;
		
		auxiliarSize = widgetW;
	}
	else
	{
		radius = (widgetH / 2) - (widgetH / 2) * 0.26;
		
		// Radius fot circle background, circle and seconds dots
		circleSeparation = (widgetH / 2) - 5;
		circleCornerRadius = (widgetH / 2) - 5;
		secondDotRadius = (widgetH / 2) - 8;
		
		// Hands lenght
		hourLength = (widgetH / 2) - (widgetH / 2) * 0.55;
		minuteLength = (widgetH / 2) - (widgetH / 2) * 0.41;
		secondLength = (widgetH / 2) - (widgetH / 2) * 0.41;
		
		auxiliarSize = widgetH;
	}
	
	innerRadius = circleSeparation - 8;
	outerRadius = circleSeparation - 2;
	
	mainBuffer.begin();
	
	// Clock background
	mainBuffer.fg(acBackgroundColorIndex);
	mainBuffer.rect(clrFG,
			centerX-circleSeparation,
			centerY-circleSeparation,
			centerX+circleSeparation,
			centerY+circleSeparation,
			circleCornerRadius);
	
	// Minutes dots
	index = 0;
	for (i = 0; i < 60; i++) {
    	index = i * 12;
		
    	x = centerX + roundCoord(
        	(float)calcSin(index) * secondDotRadius / 512);
		
    	y = centerY - roundCoord(
        	(float)calcCos(index) * secondDotRadius / 512);
		
		if (acNumbers) {
			if (i == 0 || i == 5 || i == 10 || i == 15 ||
				i == 20 || i == 25 || i == 30 || i == 35 ||
				i == 40 || i == 45 || i == 50 || i == 55) {
				mainBuffer.fg(acDotsColorIndex);
				mainBuffer.rect(clrFG, x-1, y-1, x+2, y+2, 2);
			}
			else
			{
				mainBuffer.fg(acDotsColorIndex);
				mainBuffer.pixel(clrFG, x, y);
			}
		}
		else
		{
			if (i == 5 || i == 10 || i == 15 ||
				i == 20 || i == 25 || i == 35 ||
				i == 40 || i == 50 || i == 55) {
				mainBuffer.fg(acDotsColorIndex);
				mainBuffer.rect(clrFG, x-1, y-1, x+2, y+2, 2);
			}
			else
			{
				mainBuffer.fg(acDotsColorIndex);
				mainBuffer.pixel(clrFG, x, y);
			}
		}
	}
	
	// Clock numbers
	index = 0;
	if (acNumbers) {
		for (i = 0; i < 12; i++) {
			index = i * 60;
			
			x = centerX + roundCoord(
    			(float)calcSin(index) * radius / 512);
			
			y = centerY - roundCoord(
    			(float)calcCos(index) * radius / 512) - 1;
			
			// 0 = 12 above
			if (i == 0)
				number = "12";
			else
				number = "" + i;
			
			if (i == 3 && widgetW != 70) number = "";
					
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bg(acBackgroundColorIndex);
			
			// Font size difference according to widget
			if (widgetW == 70)
				mainBuffer.font(fntStandard);
			else
				mainBuffer.font(fntLargeBold);
			
    		mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
    		// 0 = 12 o'clock
    		index = i * 60;
			
			x1 = centerX + roundCoord(
    			(float)calcSin(index) * innerRadius / 512);
			
			y1 = centerY - roundCoord(
    			(float)calcCos(index) * innerRadius / 512);
			
			x2 = centerX + roundCoord(
    			(float)calcSin(index) * outerRadius / 512);
			
			y2 = centerY - roundCoord(
    			(float)calcCos(index) * outerRadius / 512);
    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(highlightColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2);
    		}
    		else if (i == 3 && widgetW == 70) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2, y2+1);
    		}
    		else
    		{
    			if (i != 3 && widgetH == 70) {
					mainBuffer.fg(acDotsColorIndex);
					mainBuffer.pixel(clrFG, x2, y2);
				}
    		}
		}
	}
	
	// Circle around clock
	if (acCircle) {
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	}
	
	mainBuffer.end();
	
	updateClockHandsBigUI();
}


void miniAnalogClockWidget(int startX, int startY) {
	int i,
		x, y,
		x1, y1,
		x2, y2,
		radius,
		innerRadius,
		outerRadius,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius,
		index,
		auxiliarSize,
		circleRadius;
	string number;
	
	centerX = startX + (miniPanelW / 2) - 1;
	centerY = startY + (miniPanelH / 2) - 1;
	
	// Set radius
	radius = 19;
	
	circleSeparation = 19;
	circleCornerRadius = 19;
	
	// Hands lenght
	hourLength = 12;
	minuteLength = 15;
	secondLength = 15;
	
	innerRadius = circleSeparation - 5;
	outerRadius = circleSeparation - 2;
	
	mainBuffer.begin();
	
	// Clock background
	mainBuffer.fg(acBackgroundColorIndex);
	mainBuffer.rect(clrFG,
			centerX-circleSeparation,
			centerY-circleSeparation,
			centerX+circleSeparation + 1,
			centerY+circleSeparation + 1,
			circleCornerRadius);
	
	// 12 dots
	circleRadius = 17;
	for (i = 0; i < 12; i++) {
    	index = i * 60;
		
    	x = centerX + roundCoord(
        	(float)calcSin(index) * circleRadius / 512);
		
    	y = centerY - roundCoord(
        	(float)calcCos(index) * circleRadius / 512);
        
    	mainBuffer.fg(acDotsColorIndex);
    	mainBuffer.pixel(clrFG, x, y);
	}
	
	mainBuffer.end();
	
	updateClockHandsB(1);
}
