// Round coordinates for drawing and angles
int roundCoord(float value) {
    if (value >= 0)
        return (int)(value + 0.5);
    else
        return (int)(value - 0.5);
}


// Draws seconds hand
void drawHand(int index,
			  int length,
			  int centerX,
			  int centerY,
			  int colorIndex)
{
	int x, y;

	x = centerX + roundCoord((float)calcSin(index) * length / 512);
	y = centerY - roundCoord((float)calcCos(index) * length / 512);
	
	mainBuffer.fg(colorIndex);
	mainBuffer.line(clrFG, centerX, centerY, x, y);
}


// Draws hour/minutes hands
void drawHandWide(int index,
				int length,
				int baseWidth,
				int centerX,
				int centerY,
				int colorIndex)
{
	int tipX, tipY,
		baseX1, baseY1,
		baseX2, baseY2,
		baseIndex1, baseIndex2;

	// Base angles: +/- 48 degrees
	baseIndex1 = (index + 96) % 720;
	baseIndex2 = (index + 624) % 720; // -96 modulo 720

	// Tip
	tipX = centerX +
		roundCoord((float)calcSin(index) * length / 512);

	tipY = centerY -
		roundCoord((float)calcCos(index) * length / 512);

	// Base point 1
	baseX1 = centerX +
		roundCoord((float)calcSin(baseIndex1) * baseWidth / 512);

	baseY1 = centerY -
		roundCoord((float)calcCos(baseIndex1) * baseWidth / 512);

	// Base point 2
	baseX2 = centerX +
		roundCoord((float)calcSin(baseIndex2) * baseWidth / 512);

	baseY2 = centerY -
		roundCoord((float)calcCos(baseIndex2) * baseWidth / 512);

	// Color
	mainBuffer.fg(colorIndex);

	// Draw the triangular hand
	mainBuffer.line(clrFG, tipX, tipY, baseX1, baseY1);
	mainBuffer.line(clrFG, tipX, tipY, baseX2, baseY2);
}


void updateClockHands() {
	int i, x, y,
		axisXcorrection = 0,
		circleRadius,
		newHourIndex,
		newMinuteIndex,
		newSecondIndex,
		index = 0,
		baseWidth;
	
	if (widgetW != 70) {
		axisXcorrection = 38;
		secondLength = 14;
		baseWidth = 4;
	}
	else
	{
		baseWidth = 3;
	}
	
	mainBuffer.begin();
	
	// Delete old hands
	drawHand(oldSecondIndex,
			secondLength,
			centerX + axisXcorrection,
			centerY,
			acBackgroundColorIndex);
		
	drawHandWide(oldHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	drawHandWide(oldMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	// Calculate new angle index	
	newHourIndex =
		(hours % 12) * 60 + minutes;
	newMinuteIndex =
		minutes * 12;
	newSecondIndex =
		seconds * 12;
	
	// TimeBoard text on big widget
	if (widgetW != 70) {
		mainBuffer.textColor(highlightColorIndex);
    	mainBuffer.bg(acBackgroundColorIndex);
		mainBuffer.textAlign(11);
		mainBuffer.font(fntBold);
		mainBuffer.text(clrText, centerX, centerY-27, " TimeBoard");
		
		// Small circle for seconds
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG, (centerX + axisXcorrection)-17, centerY-17, (centerX + axisXcorrection)+18, centerY+18, 18, 1);
		
		// 12 dots (every 5 seconds)
		circleRadius = 16;
		for (i = 0; i < 12; i++) {
    		index = i * 60;
			
    		x = (centerX + axisXcorrection) + roundCoord(
        		(float)calcSin(index) * circleRadius / 512);
			
    		y = centerY - roundCoord(
        		(float)calcCos(index) * circleRadius / 512);
        	
    		mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondIndex,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex);
		
		// Center for seconds
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG, (centerX + axisXcorrection)-2, centerY-2, (centerX + axisXcorrection)+3, centerY+3, 3);
		
		drawHandWide(newHourIndex,
			 	hourLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawHandWide(newMinuteIndex,
			 	minuteLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
	}
	else
	{
		drawHandWide(newHourIndex,
			 	hourLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawHandWide(newMinuteIndex,
			 	minuteLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawHand(newSecondIndex,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex);
	}
	
	// Hand centre circle size according to widget size
	if (widgetW != 70) {
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 4,
			centerY - 4,
			centerX + 5,
			centerY + 5,
			5);
	}
	else
	{
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourIndex = newHourIndex;
	oldMinuteIndex = newMinuteIndex;
	oldSecondIndex = newSecondIndex;
}


void analogClockWidget(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius,
		index;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	// Set radius based on widget size
	if ((widgetW != 70) && widgetH > widgetW)
		radius = (widgetW / 2) - (widgetW / 2) * 0.26;
	else
		radius = (widgetH / 2) - (widgetH / 2) * 0.26;
	
	// Hands lenght
	hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
	minuteLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	secondLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	
	if (widgetW != 70) {
		circleSeparation = 66;
		circleCornerRadius = 66;
		secondDotRadius = 63;
	}
	else
	{
		circleSeparation = 31;
		circleCornerRadius = 31;
	}
	
	// Circles
	mainBuffer.begin();
	
	// Clock background
	if (widgetW != 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
		
		// Minutes dots
		index = 0;
		for (i = 0; i < 60; i++) {
    		index = i * 12;
			
    		x = centerX + roundCoord(
        		(float)calcSin(index) * secondDotRadius / 512);
			
    		y = centerY - roundCoord(
        		(float)calcCos(index) * secondDotRadius / 512);
			
			mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}
	}
	
	// Clock background on small widget
	if (widgetW == 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
	}
	
	// Clock numbers
	index = 0;
	if (useAnalogClockNumbers == 1) {
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			index = i * 60;
	
			x = centerX + roundCoord(
    			(float)calcSin(index) * radius / 512);
			
			y = centerY - roundCoord(
    			(float)calcCos(index) * radius / 512) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
			
			if (i == 3 && widgetW != 70) number = "";
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bg(acBackgroundColorIndex);
			
			// Font size difference according to widget
			if (widgetW == 70)
				mainBuffer.font(fntStandard);
			else
				mainBuffer.font(fntLargeBold);
			
    		mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetW / 2) * 0.66;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetW / 2) * 0.70;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		index = i * 60;
			
			x1 = centerX + roundCoord(
    			(float)calcSin(index) * innerRadius / 512);
			
			y1 = centerY - roundCoord(
    			(float)calcCos(index) * innerRadius / 512);
			
			x2 = centerX + roundCoord(
    			(float)calcSin(index) * outerRadius / 512);
			
			y2 = centerY - roundCoord(
    			(float)calcCos(index) * outerRadius / 512);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(acSecondsColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
				mainBuffer.fg(acNumbersColorIndex);
				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	// Circle around clock
	mainBuffer.fg(highlightColorIndex);
	mainBuffer.frame(clrFG,
					centerX-circleSeparation,
					centerY-circleSeparation,
					centerX+circleSeparation,
					centerY+circleSeparation,
					circleCornerRadius,
					1);
	
	mainBuffer.end();
	updateClockHands();
}


void updateClockHands2() {
	int i, x, y,
		axisXcorrection = 0,
		axisYcorrection = 0,
		circleRadius,
		newHourIndex,
		newMinuteIndex,
		newSecondIndex,
		index = 0,
		baseWidth;
	
	if (interfaceMode == 1) {
		axisXcorrection = 70;
		axisYcorrection = 0;
		secondLength = 16;
	}
	
	if (widgetW != 70)
		baseWidth = 4;
	else
		baseWidth = 3;
	
	mainBuffer.begin();
	
	// Delete old hands
	drawHand(oldSecondIndex,
			secondLength,
			centerX + axisXcorrection,
			centerY + axisYcorrection,
			acBackgroundColorIndex);
	
	drawHandWide(oldHourIndex,
			hourLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);

	drawHandWide(oldMinuteIndex,
			minuteLength,
			baseWidth,
			centerX,
			centerY,
			acBackgroundColorIndex);
	
	// Calculate new angle index	
	newHourIndex =
		(hours % 12) * 60 + minutes;
	newMinuteIndex =
		minutes * 12;
	newSecondIndex =
		seconds * 12;
	
	if (widgetW != 70) {		
		// Background
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21);
		
		// Small circle for seconds
    	mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21, 1);
		
		// 12 dots (every 5 seconds)
		circleRadius = 19;
		
		for (i = 0; i < 12; i++) {
    		index = i * 60;
			
    		x = (centerX + axisXcorrection) + roundCoord(
        		(float)calcSin(index) * circleRadius / 512);
			
    		y = (centerY + axisYcorrection) - roundCoord(
        		(float)calcCos(index) * circleRadius / 512);
        	    		
    		mainBuffer.fg(acNumbersColorIndex);
    		mainBuffer.pixel(clrFG, x, y);
		}
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondIndex,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	acSecondsColorIndex);
				
		drawHandWide(newHourIndex,
			 	hourLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawHandWide(newMinuteIndex,
			 	minuteLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
	}
	else
	{
		drawHandWide(newHourIndex,
			 	hourLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
		
		drawHandWide(newMinuteIndex,
			 	minuteLength,
			 	baseWidth,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex);
			 	
		drawHand(newSecondIndex,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex);
	}
	
	// HOUR: Center size according to widget size
	if (widgetW != 70) {
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 4,
			centerY - 4,
			centerX + 5,
			centerY + 5,
			5);
		
		// Center for seconds
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-2, (centerY+axisYcorrection)-2, (centerX+axisXcorrection)+3, (centerY+axisYcorrection)+3, 3);
	}
	else
	{
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourIndex = newHourIndex;
	oldMinuteIndex = newMinuteIndex;
	oldSecondIndex = newSecondIndex;
}


void analogClockWidget2(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius,
		index;
	string number;
	
	centerX = startX + (widgetW / 2) - 28;
	centerY = startY + (widgetH / 2);
	
	radius = (widgetH / 2) - (widgetH / 2) * 0.28;
	
	// Hands lenght
	hourLength = (widgetH / 2) - (widgetH / 2) * 0.55;
	minuteLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	secondLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	
	if (widgetW != 70) {
		circleSeparation = 40;
		circleCornerRadius = 40;
		secondDotRadius = 38;
	}
	else
	{
		circleSeparation = 31;
		circleCornerRadius = 31;
	}
	
	mainBuffer.begin();
	
	// Clock background
	if (widgetW != 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation+1,
				centerY+circleSeparation+1,
				circleCornerRadius);
		
		// Minutes dots
		index = 0;	
		for (i = 0; i < 60; i++) {
    		index = i * 12;
			
    		x = centerX + roundCoord(
        		(float)calcSin(index) * secondDotRadius / 512);
			
    		y = centerY - roundCoord(
        		(float)calcCos(index) * secondDotRadius / 512);
    		
			mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}

	}
	
	// Clock background on small widget
	if (widgetW == 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
	}
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		index = 0;
		for (i = 0; i < 12; i++) {
			
			// 0 = 12 upwards
			index = i * 60;
			
			x = centerX + roundCoord(
    			(float)calcSin(index) * radius / 512);
			
			y = centerY - roundCoord(
    			(float)calcCos(index) * radius / 512) - 1;
			
			if (i == 0)
				number = "12";
			else
				number = "" + i;
			
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.font(fntStandard);
			
			mainBuffer.bg(acBackgroundColorIndex);
			mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetH / 2) * 0.66;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetH / 2) * 0.70;
    			outerRadius = (widgetH / 2) * 0.76;
			}
			
    		// 0 = 12 o'clock
    		index = i * 60;
			
			x1 = centerX + roundCoord(
    			(float)calcSin(index) * innerRadius / 512);
			
			y1 = centerY - roundCoord(
    			(float)calcCos(index) * innerRadius / 512);
			
			x2 = centerX + roundCoord(
    			(float)calcSin(index) * outerRadius / 512);
			
			y2 = centerY - roundCoord(
    			(float)calcCos(index) * outerRadius / 512);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(highlightColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			mainBuffer.fg(mainColorIndex);
    			if (widgetW != 70)
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			else
    				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	// Circle around clock
	if (widgetH != 70) {				
		if (colorDepth > 4)
			mainBuffer.fg(highlightColorIndex);
		else
			mainBuffer.fg(mainColorIndex);
		
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation+1,
						centerY+circleSeparation+1,
						circleCornerRadius,
						1);
	}
	else
	{
		// Small circle around clock on small widget		
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	}
	
	updateClockHands2();
	mainBuffer.end();
}
