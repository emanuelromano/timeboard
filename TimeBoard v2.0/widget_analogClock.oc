// Round coordinates for drawing and angles
int roundCoord(float value) {
    if (value >= 0)
        return (int)(value + 0.5);
    else
        return (int)(value - 0.5);
}


// Draws hand with given parameters
void drawHand(float angle,
			  int length,
			  int centerX,
			  int centerY,
			  int colorIndex,
			  bool isSecond)
{
	int x, y;
	
	mainBuffer.begin();
	mainBuffer.fg(colorIndex);
	
	x = centerX + roundCoord(cos(angle) * length);
	y = centerY + roundCoord(sin(angle) * length);
	
	mainBuffer.line(clrFG, centerX, centerY, x, y);
	
	// Little dot on the end of hands
	if (widgetW != 70 && !isSecond) mainBuffer.rect(clrFG, x-1, y-1, x+2, y+2, 2);
	
	mainBuffer.end();
}


void updateClockHands() {
	int i, x, y,
		axisXcorrection = 0,
		circleRadius;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (widgetW != 70) {
		axisXcorrection = 38;
		secondLength = 14;
	}
	
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acBackgroundColorIndex,
			 	true);
			
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acBackgroundColorIndex,
			 	false);
		
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acBackgroundColorIndex,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	// TimeBoard text on big widget
	if (widgetW != 70) {
		mainBuffer.begin();
		mainBuffer.textColor(highlightColorIndex);
    	mainBuffer.bg(acBackgroundColorIndex);
		mainBuffer.textAlign(11);
		mainBuffer.font(fntBold);
		mainBuffer.text(clrText, centerX, centerY-27, " TimeBoard");
		
		// Small circle for seconds
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG, (centerX + axisXcorrection)-17, centerY-17, (centerX + axisXcorrection)+18, centerY+18, 18, 1);
		
		// 12 dots (every 5 seconds)
		circleRadius = 16;
		for (i = 0; i < 12; i++) {
			angle = ((i * 30) - 90) * pi / 180;
			
			x = (centerX + axisXcorrection) + roundCoord(cos(angle) * circleRadius);
			y = centerY + roundCoord(sin(angle) * circleRadius);
			
    		mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex,
			 	true);
		
		// Center for seconds
		mainBuffer.begin();
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG, (centerX + axisXcorrection)-2, centerY-2, (centerX + axisXcorrection)+3, centerY+3, 3);
		mainBuffer.end();
		
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
		
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex,
			 	true);
	}
	
	// Hand centre circle size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius;
	float angle;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	// Set radius based on widget size
	if ((widgetW != 70) && widgetH > widgetW)
		radius = (widgetW / 2) - (widgetW / 2) * 0.26;
	else
		radius = (widgetH / 2) - (widgetH / 2) * 0.26;
	
	// Hands lenght
	hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
	minuteLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	secondLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	
	if (widgetW != 70) {
		circleSeparation = 66;
		circleCornerRadius = 66;
		secondDotRadius = 63;
	}
	else
	{
		circleSeparation = 31;
		circleCornerRadius = 31;
	}
	
	// Circles
	mainBuffer.begin();
	
	// Clock background
	if (widgetW != 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
		
		// Minutes dots
		for (i = 0; i < 60; i++) {
			
			angle = ((i * 6) - 90) * 3.14159265 / 180;
			
			x = centerX + roundCoord(cos(angle) * secondDotRadius);
			y = centerY + roundCoord(sin(angle) * secondDotRadius) - 1;
			
			mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}
	}
	
	// Clock background on small widget
	if (widgetW == 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
	}
	
	// Clock numbers
	if (useAnalogClockNumbers == 1) {
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
			
			if (i == 3 && widgetW != 70) number = "";
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bg(acBackgroundColorIndex);
			
			// Font size difference according to widget
			if (widgetW == 70)
				mainBuffer.font(fntStandard);
			else
				mainBuffer.font(fntLargeBold);
			
    		mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetW / 2) * 0.66;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetW / 2) * 0.70;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(acSecondsColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
				mainBuffer.fg(acNumbersColorIndex);
				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	// Circle around clock
	mainBuffer.fg(highlightColorIndex);
	mainBuffer.frame(clrFG,
					centerX-circleSeparation,
					centerY-circleSeparation,
					centerX+circleSeparation,
					centerY+circleSeparation,
					circleCornerRadius,
					1);
	
	updateClockHands();
	mainBuffer.end();
}


void updateClockHands2() {
	int i, x, y,
		axisXcorrection = 0,
		axisYcorrection = 0,
		circleRadius,
		color, bgColor, secColor;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (interfaceMode == 1) {
		axisXcorrection = 70;
		axisYcorrection = 0;
		secondLength = 16;
	}
		
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	acBackgroundColorIndex,
			 	true);
		
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acBackgroundColorIndex,
			 	false);
	
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acBackgroundColorIndex,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	if (widgetW != 70) {
		mainBuffer.begin();
		
		// Background
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21);
		
		// Small circle for seconds
    	mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21, 1);
		
		// 12 dots (every 5 seconds)
		circleRadius = 19;
		
		for (i = 0; i < 12; i++) {
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
		
    		x = (centerX + axisXcorrection) + roundCoord(cos(angle) * circleRadius);
    		y = (centerY + axisYcorrection) + roundCoord(sin(angle) * circleRadius);
    		
    		mainBuffer.fg(acNumbersColorIndex);
    		mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	acSecondsColorIndex,
			 	true);
				
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	acHourMinColorIndex,
			 	false);
			 	
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	acSecondsColorIndex,
			 	true);
	}
	
	// HOUR: Center size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
		
		// Center for seconds
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-2, (centerY+axisYcorrection)-2, (centerX+axisXcorrection)+3, (centerY+axisYcorrection)+3, 3);

	}
	else
	{
		mainBuffer.fg(acCenterColorIndex);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget2(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius;
	float angle;
	string number;
	
	centerX = startX + (widgetW / 2) - 28;
	centerY = startY + (widgetH / 2);
	
	radius = (widgetH / 2) - (widgetH / 2) * 0.28;
	
	// Hands lenght
	hourLength = (widgetH / 2) - (widgetH / 2) * 0.55;
	minuteLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	secondLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	
	if (widgetW != 70) {
		circleSeparation = 40;
		circleCornerRadius = 40;
		secondDotRadius = 38;
	}
	else
	{
		circleSeparation = 31;
		circleCornerRadius = 31;
	}
	
	// Circles
	mainBuffer.begin();
	
	// Clock background
	if (widgetW != 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation+1,
				centerY+circleSeparation+1,
				circleCornerRadius);
		
		// Minutes dots
		for (i = 0; i < 60; i++) {
			
			angle = ((i * 6) - 90) * 3.14159265 / 180;
			
			x = centerX + roundCoord(cos(angle) * secondDotRadius);
			y = centerY + roundCoord(sin(angle) * secondDotRadius);
			
			mainBuffer.fg(acNumbersColorIndex);
			mainBuffer.pixel(clrFG, x, y);
		}
	}
	
	// Clock background on small widget
	if (widgetW == 70) {
		mainBuffer.fg(acBackgroundColorIndex);
		mainBuffer.rect(clrFG,
				centerX-circleSeparation,
				centerY-circleSeparation,
				centerX+circleSeparation,
				centerY+circleSeparation,
				circleCornerRadius);
	}
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.font(fntStandard);
			
			mainBuffer.bg(acBackgroundColorIndex);
			mainBuffer.textColor(acNumbersColorIndex);
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetH / 2) * 0.66;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetH / 2) * 0.70;
    			outerRadius = (widgetH / 2) * 0.76;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fg(highlightColorIndex);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			mainBuffer.fg(mainColorIndex);
    			if (widgetW != 70)
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			else
    				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	// Circle around clock
	if (widgetH != 70) {				
		if (colorDepth > 4)
			mainBuffer.fg(highlightColorIndex);
		else
			mainBuffer.fg(mainColorIndex);
		
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation+1,
						centerY+circleSeparation+1,
						circleCornerRadius,
						1);
	}
	else
	{
		// Small circle around clock on small widget		
		mainBuffer.fg(highlightColorIndex);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	}
	
	updateClockHands2();
	mainBuffer.end();
}
