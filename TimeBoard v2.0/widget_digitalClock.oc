void digitalClockWidget(int startX, int startY) {
	string amPmStr;
	int digitW = 16,
		digitH = 28,
		radius = fontRadius,
		segmentThickness = 6,
		
		digitHr1X = startX + 6,
		digitHr2X = digitHr1X + digitW + 3,
		
		digitMin1X = startX + 6,
		digitMin2X = digitMin1X + digitW + 3,
		
		digitY1 = startY + 6,
		digitY2 = digitY1 + digitH + 3;
	
	splitTimeDigits();
	
	amPmStr = "AM";
	
	mainBuffer.begin();
	// Hour
	mainBuffer.fg(highlightColorIndex);
	// drawDigit() comes from globalFunctions.oc
	drawDigit(hourDigit1, digitW, digitH, digitHr1X, digitY1, radius, segmentThickness);
	drawDigit(hourDigit2, digitW, digitH, digitHr2X, digitY1, radius, segmentThickness);
	
	// Minutes
	mainBuffer.fg(mainColorIndex);
	drawDigit(minuteDigit1, digitW, digitH, digitMin1X, digitY2, radius, segmentThickness);
	drawDigit(minuteDigit2, digitW, digitH, digitMin2X, digitY2, radius, segmentThickness);
	
	// AP/PM
	/*mainBuffer.textAlign(02);
	mainBuffer.textColor(highlightColorIndex);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+widgetW-5, startY+4, amPmStr);*/
	
	// Seconds
	mainBuffer.textColor(mainColorIndex);
	mainBuffer.textAlign(22);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+widgetW-5, startY+widgetH-6, "   " + secondDigit1 + "" + secondDigit2);
	mainBuffer.end();
}


void digitalClockWidgetC(int startX, int startY) {
	string amPmStr;
	int digitW1 = 31,
		digitH1 = 60,
		radius = fontRadius,
		segmentThickness1 = 12,
		
		digitHr1X = startX + 8,
		digitHr2X = digitHr1X + digitW1 + 6,
		
		digitY1 = startY + 20;
	
	int digitW2 = 24,
		digitH2 = 36,
		segmentThickness2 = 8,
		
		digitMin1X = digitHr2X + digitW1 + 6,
		digitMin2X = digitMin1X + digitW2 + 6,
		
		digitY2 = startY + 20;
	
	splitTimeDigits();
	
	amPmStr = "AM";
	
	mainBuffer.begin();
	// Hour
	mainBuffer.fg(highlightColorIndex);
	// drawDigit() comes from globalFunctions.oc
	drawDigit(hourDigit1, digitW1, digitH1, digitHr1X, digitY1, radius, segmentThickness1);
	drawDigit(hourDigit2, digitW1, digitH1, digitHr2X, digitY1, radius, segmentThickness1);
	
	// Minutes
	mainBuffer.fg(mainColorIndex);
	drawDigit(minuteDigit1, digitW2, digitH2, digitMin1X, digitY2, radius, segmentThickness2);
	drawDigit(minuteDigit2, digitW2, digitH2, digitMin2X, digitY2, radius, segmentThickness2);
	
	// AP/PM
	/*mainBuffer.textAlign(02);
	mainBuffer.textColor(highlightColorIndex);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+widgetW-5, startY+4, amPmStr);*/
	
	// Seconds
	mainBuffer.textColor(mainColorIndex);
	mainBuffer.textAlign(22);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+widgetW-7, startY+widgetH-8, "   " + secondDigit1 + "" + secondDigit2);
	mainBuffer.end();
}


void miniDigitalClockWidget(int startX, int startY) {
	int digitW = 10,
	digitH = 18,
	radius = fontRadius,
	segmentThickness = 4,
	
	digitHr1X = startX,
	digitHr2X = digitHr1X + digitW + 3,
	
	digitMin1X = startX,
	digitMin2X = digitMin1X + digitW + 3,
	
	digitY1 = startY - 1,
	digitY2 = digitY1 + digitH + 3,	
	
	secondsX = startX + (miniPanelW / 2),
	secondsY = startY + (miniPanelH / 2);
	
	splitTimeDigits();
	
	mainBuffer.begin();
	mainBuffer.fg(highlightColorIndex);
	mainBuffer.bg(widgetColorIndex);
	// Hour
	drawDigit(hourDigit1, digitW, digitH, digitHr1X, digitY1, radius, segmentThickness);
	drawDigit(hourDigit2, digitW, digitH, digitHr2X, digitY1, radius, segmentThickness);
	
	// Minutes
	mainBuffer.fg(mainColorIndex);
	drawDigit(minuteDigit1, digitW, digitH, digitMin1X, digitY2, radius, segmentThickness);
	drawDigit(minuteDigit2, digitW, digitH, digitMin2X, digitY2, radius, segmentThickness);
	
	// Seconds
	if (colorDepth > 4 || colorDepth == 1)
		mainBuffer.textColor(mainColorIndex);
	else
		mainBuffer.textColor(highlightColorIndex);
	
	mainBuffer.textAlign(11);
	mainBuffer.font(fntStandard);
	mainBuffer.text(clrText, secondsX+14, secondsY+14, secondDigit1 + "" + secondDigit2);
	mainBuffer.end();
}
