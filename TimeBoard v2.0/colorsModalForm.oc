Draw prefsBuffer;
string colorElements[3];
int prefsBufferX, prefsBufferY,
	popupSelection;

void showColorControls() {
	// Controls set to be visible
	colorPopup.visible = true;
	color1Btn.visible = true;
	color2Btn.visible = true;
	color3Btn.visible = true;
	color4Btn.visible = true;
	if (popupSelection != 2)
		color5Btn.visible = true;
	else
		color5Btn.visible = false;
	
	label1.visible = true;
	label2.visible = true;
	label3.visible = true;
	label4.visible = true;
	label5.visible = true;
}

void drawWidgetRepresentation() {
	int startX = 7,
		startY = 7,
		widW = 70,
		widH = 70,
		digitW = 16,
		digitH = 28,
		radius = fontRadius,
		segmentThickness = 6,
	
		digitHr1X = startX + 6,
		digitHr2X = digitHr1X + digitW + 3,
		
		digitMin1X = startX + 6,
		digitMin2X = digitMin1X + digitW + 3,
		
		digitY1 = startY + 6,
		digitY2 = digitY1 + digitH + 3;
	
	prefsBuffer.begin();
	// Background
	prefsBuffer.fg(backgroundColorIndex);
	prefsBuffer.rect(clrFG, 0, 0, 85, 85, 0);
	
	// Shadow
	prefsBuffer.fg(shadowColorIndex);
	prefsBuffer.rect(clrFG, startX, startY, startX+widW+1, startY+widH+1, widgetCornerRadius);
	
	// Widget
	prefsBuffer.fg(widgetColorIndex);
	prefsBuffer.rect(clrFG, startX+1, startY+1, startX+widW-1, startY+widH-1, widgetCornerRadius);
	
	// Hour
	prefsBuffer.fg(highlightColorIndex);
	// drawDigit() comes from globalFunctions.oc
	drawDigit("1", digitW, digitH, digitHr1X, digitY1, radius, segmentThickness);
	drawDigit("2", digitW, digitH, digitHr2X, digitY1, radius, segmentThickness);
	
	// Minutes
	prefsBuffer.fg(mainColorIndex);
	drawDigit("3", digitW, digitH, digitMin1X, digitY2, radius, segmentThickness);
	drawDigit("4", digitW, digitH, digitMin2X, digitY2, radius, segmentThickness);

	// Seconds
	prefsBuffer.textAlign(22);
	prefsBuffer.bg(widgetColorIndex);
	mainBuffer.textColor(mainColorIndex);
	prefsBuffer.font(fntLargeBold);
	prefsBuffer.text(clrText, startX+widW-5, startY+widH-6, "56");
	prefsBuffer.end();
	
	draw.begin();
	draw.draw(prefsBuffer, prefsBufferX, prefsBufferY);
	draw.end();
	
	label1.text = "Background";
	label2.text = "Widgets";
	label3.text = "Shadows";
	label4.text = "Highlights";
	label5.text = "Main";
	
	showColorControls();
}


void drawAnalogClockRepresentation() {
	int startX = 0,
		startY = 0,
		widW = 85,
		widH = 85,
		i, x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		cenX, cenY,
		hourLen, minuteLen, secondLen,
		circleSeparation,
		circleCornerRadius,
		minuteDotRadius,
		index;
	string number;
	
	cenX = startX + (widW / 2);
	cenY = startY + (widH / 2);
	
	radius = (widW / 2) - (widH / 2) * 0.3;
	
	// Hands lenght
	hourLen = (widW / 2) - (widW / 2) * 0.55;
	minuteLen = (widW / 2) - (widW / 2) * 0.44;
	secondLen = (widW / 2) - (widW / 2) * 0.44;
	
	prefsBuffer.begin();
		
	// Widget background
	prefsBuffer.fg(widgetColorIndex);
	prefsBuffer.rect(clrFG, startX, startY, startX+widW, startY+widH, 0);
	
	// Clock background
	circleSeparation = 38;
	circleCornerRadius = 38;
	
	prefsBuffer.fg(acBackgroundColorIndex);
	prefsBuffer.rect(clrFG,
					cenX-circleSeparation,
					cenY-circleSeparation,
					cenX+circleSeparation+1,
					cenY+circleSeparation+1,
					circleCornerRadius);
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		index = 0;
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			index = i * 60;
	
    		x = cenX + roundCoord(
        		(float)calcSin(index) * radius / 512);
		
    		y = cenY - roundCoord(
        		(float)calcCos(index) * radius / 512) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			prefsBuffer.textAlign(11);
			prefsBuffer.bg(acBackgroundColorIndex);
			prefsBuffer.font(fntStandard);
    		prefsBuffer.textColor(acNumbersColorIndex);
			prefsBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		index = 0;
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widW / 2) * 0.66;
    			outerRadius = (widW / 2) * 0.80;
			}
			else
			{
    			// Shorter lines
    			innerRadius = (widW / 2) * 0.70;
    			outerRadius = (widW / 2) * 0.76;
			}
			
    		// 0 = 12 o'clock
    		index = i * 60;
			
    		x1 = cenX + roundCoord(
        		(float)calcSin(index) * innerRadius / 512);
		
    		y1 = cenY - roundCoord(
        		(float)calcCos(index) * innerRadius / 512);
		
    		x2 = cenX + roundCoord(
        		(float)calcSin(index) * outerRadius / 512);
		
    		y2 = cenY - roundCoord(
        		(float)calcCos(index) * outerRadius / 512);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		prefsBuffer.fg(acSecondsColorIndex);
    		if (i == 0) {
    			prefsBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			prefsBuffer.line(clrFG, x1, y1, x2, y2);
    			prefsBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			prefsBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			prefsBuffer.line(clrFG, x1, y1, x2, y2);
    			prefsBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			prefsBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			prefsBuffer.line(clrFG, x1, y1, x2, y2);
    			prefsBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			prefsBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			prefsBuffer.line(clrFG, x1, y1, x2, y2);
    			prefsBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			prefsBuffer.fg(mainColorIndex);
    			prefsBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    		}
		}
	}
	
	// Circle around clock on widget
	circleSeparation = 38;
	circleCornerRadius = 38;
	
	prefsBuffer.fg(highlightColorIndex);
	prefsBuffer.frame(clrFG,
					cenX-circleSeparation,
					cenY-circleSeparation,
					cenX+circleSeparation+1,
					cenY+circleSeparation+1,
					circleCornerRadius,
					1);
	
	// Minutes dots
	minuteDotRadius = 36;
	index = 0;
	for (i = 0; i < 60; i++) {
		index = i * 12;
	
    	x = cenX + roundCoord(
        	(float)calcSin(index) * minuteDotRadius / 512);
	
    	y = cenY - roundCoord(
        	(float)calcCos(index) * minuteDotRadius / 512);
		
		prefsBuffer.fg(acNumbersColorIndex);
		prefsBuffer.pixel(clrFG, x, y);
	}
	
	// Hour
	prefsBuffer.fg(acHourMinColorIndex);

	index = 0;
	
	x = cenX + roundCoord(
    	(float)calcSin(index) * hourLen / 512);
	
	y = cenY - roundCoord(
    	(float)calcCos(index) * hourLen / 512);
	
	prefsBuffer.line(clrFG, cenX-3, cenY, x, y);
	prefsBuffer.line(clrFG, cenX+3, cenY, x, y);
	
	// Minute
	prefsBuffer.fg(acHourMinColorIndex);
	
	index = 539;
	
	x = cenX + roundCoord(
    	(float)calcSin(index) * minuteLen / 512);
	
	y = cenY - roundCoord(
    	(float)calcCos(index) * minuteLen / 512);
	
	prefsBuffer.line(clrFG, cenX, cenY-3, x, y);
	prefsBuffer.line(clrFG, cenX, cenY+3, x, y);
	
	// Second
	prefsBuffer.fg(acSecondsColorIndex);
	
	index = 630;
	
	x = cenX + roundCoord(
    	(float)calcSin(index) * secondLen / 512);
	
	y = cenY - roundCoord(
    	(float)calcCos(index) * secondLen / 512);
	
	prefsBuffer.line(clrFG, cenX, cenY, x, y);
	
	// Clock center
	prefsBuffer.fg(acCenterColorIndex);
	prefsBuffer.rect(clrFG,
		cenX - 4,
		cenY - 4,
		cenX + 5,
		cenY + 5,
		5);
	
	prefsBuffer.end();
	
	draw.begin();
	draw.draw(prefsBuffer, prefsBufferX, prefsBufferY);
	draw.end();
	
	label1.text = "Background";
	label2.text = "Numbers";
	label3.text = "Hour/min";
	label4.text = "Seconds";
	label5.text = "Center";

	showColorControls();
}


void drawBatteryRepresentation() {
	int startX = 0,
		startY = 0,
		widW = 85,
		widH = 85,
		dotRadius = 5,
		ringRadius = 22,
		cenX, cenY,
		iconX = startX + 7,
		iconY = startY + 70,
		textY = startY + 67,
		i, x, y,
		battColorIndex,
		index;
	
	cenX = startX + (widW / 2);
	cenY = startY + (widH / 2) - 7;
	
	prefsBuffer.begin();
	
	// Widget background
	prefsBuffer.fg(widgetColorIndex);
	prefsBuffer.rect(clrFG, startX, startY, startX+widW, startY+widH, 0);
	
	for (i = 0; i < 10; i++) {
		index = i * 72;

    	x = cenX + roundCoord(
        	(float)calcSin(index) * ringRadius / 512);
	
    	y = cenY - roundCoord(
        	(float)calcCos(index) * ringRadius / 512);

		if (i == 0 || i == 1) {
			prefsBuffer.fg(battery20ColorIndex);
			
			prefsBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
		else if (i == 2 || i == 3) {
			prefsBuffer.fg(battery40ColorIndex);
			
			prefsBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
		else if (i == 4 || i == 5 || i == 6) {
			prefsBuffer.fg(batteryColorIndex);
			
			prefsBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
		else
		{
			prefsBuffer.fg(batteryEmptyColorIndex);
			
			prefsBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
	}
	
	// Battery icon
	prefsBuffer.fg(mainColorIndex);
	prefsBuffer.frame(clrFG, iconX, iconY, iconX+15, iconY+8, 2, 1);
	prefsBuffer.line(clrFG, iconX+16, iconY+2, iconX+16, iconY+5);
	
	prefsBuffer.fg(highlightColorIndex);
	prefsBuffer.rect(clrFG, iconX+1, iconY+1, iconX+14, iconY+7, 1);
	
	// Dummy battery text
	mainBuffer.textColor(mainColorIndex);	
	mainBuffer.textAlign(02);
	mainBuffer.bg(widgetColorIndex);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+80, textY, "100%");
	
	prefsBuffer.end();
	
	draw.begin();
	draw.draw(prefsBuffer, prefsBufferX, prefsBufferY);
	draw.end();
	
	label1.text = "Empty";
	label2.text = "100-50%";
	label3.text = "40-30%";
	label4.text = "20-10%";
	label5.text = "";

	showColorControls();
}


void drawColorSquares() {
	switch (popupSelection) {
		case 0:
			draw.begin();
			// Background
			draw.fg(backgroundColorIndex);
			draw.rect(clrFG, color1Btn.x+1, color1Btn.y+1, color1Btn.x+11, color1Btn.y+11, 0);
			// Widgets
			draw.fg(widgetColorIndex);
			draw.rect(clrFG, color2Btn.x+1, color2Btn.y+1, color2Btn.x+11, color2Btn.y+11, 0);
			// Shadows
			draw.fg(shadowColorIndex);
			draw.rect(clrFG, color3Btn.x+1, color3Btn.y+1, color3Btn.x+11, color3Btn.y+11, 0);
			// Highlights
			draw.fg(highlightColorIndex);
			draw.rect(clrFG, color4Btn.x+1, color4Btn.y+1, color4Btn.x+11, color4Btn.y+11, 0);
			// Main
			draw.fg(mainColorIndex);
			draw.rect(clrFG, color5Btn.x+1, color5Btn.y+1, color5Btn.x+11, color5Btn.y+11, 0);
			draw.end();
			break;
		case 1:
			draw.begin();
			// Background
			draw.fg(acBackgroundColorIndex);
			draw.rect(clrFG, color1Btn.x+1, color1Btn.y+1, color1Btn.x+11, color1Btn.y+11, 0);
			// Numbers
			draw.fg(acNumbersColorIndex);
			draw.rect(clrFG, color2Btn.x+1, color2Btn.y+1, color2Btn.x+11, color2Btn.y+11, 0);
			// Hour/min
			draw.fg(acHourMinColorIndex);
			draw.rect(clrFG, color3Btn.x+1, color3Btn.y+1, color3Btn.x+11, color3Btn.y+11, 0);
			// Seconds
			draw.fg(acSecondsColorIndex);
			draw.rect(clrFG, color4Btn.x+1, color4Btn.y+1, color4Btn.x+11, color4Btn.y+11, 0);
			// Center
			draw.fg(acCenterColorIndex);
			draw.rect(clrFG, color5Btn.x+1, color5Btn.y+1, color5Btn.x+11, color5Btn.y+11, 0);
			draw.end();
			break;
		case 2:
			draw.begin();
			// Empty
			draw.fg(batteryEmptyColorIndex);
			draw.rect(clrFG, color1Btn.x+1, color1Btn.y+1, color1Btn.x+11, color1Btn.y+11, 0);
			// 100-50%
			draw.fg(batteryColorIndex);
			draw.rect(clrFG, color2Btn.x+1, color2Btn.y+1, color2Btn.x+11, color2Btn.y+11, 0);
			// 40-30%
			draw.fg(battery40ColorIndex);
			draw.rect(clrFG, color3Btn.x+1, color3Btn.y+1, color3Btn.x+11, color3Btn.y+11, 0);
			// 20-0%
			draw.fg(battery20ColorIndex);
			draw.rect(clrFG, color4Btn.x+1, color4Btn.y+1, color4Btn.x+11, color4Btn.y+11, 0);
			// NON VISIBLE
			//draw.fg();
			//draw.rect(clrFG, color5Btn.x+1, color5Btn.y+1, color5Btn.x+11, color5Btn.y+11, 0);
			draw.end();
			break;
	}
}


void colorPopupSelection(int selection) {
	switch (selection) {
		case 0:
				drawWidgetRepresentation();
				drawColorSquares();
				break;
		case 1:
				drawAnalogClockRepresentation();
				drawColorSquares();
				break;
		case 2:
				drawBatteryRepresentation();
				drawColorSquares();
				break;
	}
}


handler colorsModalForm.onopen() {
	draw.attachForm(this);
	prefsBuffer.create(156, 85);
	
	prefsBufferX = 3;
	prefsBufferY = 32;
	
	colorElements[0] = "General";
	colorElements[1] = "Analog clock";
	colorElements[2] = "Battery";
	colorList.setitems(3, colorElements);
	
	colorPopup.text = colorElements[0];
}


handler colorsModalForm.ondraw() {
	popupSelection = e.value; // "General"
	colorPopupSelection(popupSelection);
}


handler colorPopup.onlistselect() {
	popupSelection = e.value;
	colorPopup.text = colorElements[popupSelection];
	colorPopupSelection(popupSelection);
}


// Button 1 color selector
handler color1Btn.onselect() {
	switch (popupSelection) {
		case 0:
			draw.selectIndex("Choose background color:", &backgroundColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 1:
			draw.selectIndex("Choose background color:", &acBackgroundColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 2:
			draw.selectIndex("Choose empty batt. color:", &batteryEmptyColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
	}
}


// Button 2 color selector
handler color2Btn.onselect() {
	switch (popupSelection) {
		case 0:
			draw.selectIndex("Choose widget color:", &widgetColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 1:
			draw.selectIndex("Choose numbers color:", &acNumbersColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 2:
			draw.selectIndex("Choose 100-50% color:", &batteryColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
	}
}


// Button 3 color selector
handler color3Btn.onselect() {
	switch (popupSelection) {
		case 0:
			draw.selectIndex("Choose shadow color:", &shadowColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 1:
			draw.selectIndex("Choose hour/min. color:", &acHourMinColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 2:
			draw.selectIndex("Choose 40-30% color:", &battery40ColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
	}
}


// Button 4 color selector
handler color4Btn.onselect() {
	switch (popupSelection) {
		case 0:
			draw.selectIndex("Choose highlight color:", &highlightColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 1:
			draw.selectIndex("Choose seconds color:", &acSecondsColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 2:
			draw.selectIndex("Choose 20-10% color:", &battery20ColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
	}
}


// Button 5 color selector
handler color5Btn.onselect() {
	switch (popupSelection) {
		case 0:
			draw.selectIndex("Choose main color:", &mainColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 1:
			draw.selectIndex("Choose center color:", &acCenterColorIndex);
			colorPopupSelection(popupSelection);
			drawColorSquares();
			break;
		case 2:
			// No function
			break;
	}
}


handler colorsModalBackBtn.onselect() {
	prefsBuffer.release();
	colorsModalForm.close();
}


handler colorsModalSaveBtn.onselect() {
	saveMainPreferences();
	prefsBuffer.release();
	colorsModalForm.close();
}
