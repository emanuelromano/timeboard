/* ------------------------------------------------------------
	TimeBoard - A new clock app for Palm OS
	
	Written by @coloraturip
	
	VERSION 2.0.0 - Supports Palm OS 3.5 or newer
	
	Project started on March 13th, 2025
--------------------------------------------------------------- */

Preferences prefs;
Event e;
Date date;
Draw mainBuffer;
Draw draw;


struct AppPrefs {
	bool debugFlag;
	
	// Background color
	int bgColorR;
	int bgColorG;
	int bgColorB;
	
	// Foreground color on widgets
	int fgColorR;
	int fgColorG;
	int fgColorB;
	
	// Highlight color on widgets
	int highlightR;
	int highlightG;
	int highlightB;
	
	// Base color on widgets
	int mainR;
	int mainG;
	int mainB;
	
	// Battery color between 100% - 50% charge 
	int batteryR;
	int batteryG;
	int batteryB;
	
	// Other preferences
	int interfaceMode;
	bool widgetHighlight;
	bool widgetShadow;
	int widgetCornerRadius;
	int useAnalogClockNumbers;
};

AppPrefs appPrefs[1];


// Getting saved preferences
// Returns false if there is no stored preferences
bool getPrefs() {
	return prefs.get(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), 1);
}


// Set default preferences in case they do not exist
bool setDefaultPrefs() {
	appPrefs[0].debugFlag = false;
	
	appPrefs[0].bgColorR = 51;
	appPrefs[0].bgColorG = 51;
	appPrefs[0].bgColorB = 51;
	
	appPrefs[0].fgColorR = 68;
	appPrefs[0].fgColorG = 68;
	appPrefs[0].fgColorB = 68;
	
	appPrefs[0].highlightR = 255;
	appPrefs[0].highlightG = 204;
	appPrefs[0].highlightB = 0;
	
	appPrefs[0].mainR = 255;
	appPrefs[0].mainG = 255;
	appPrefs[0].mainB = 255;
	
	appPrefs[0].batteryR = 102;
	appPrefs[0].batteryG = 255;
	appPrefs[0].batteryB = 0;
	
	appPrefs[0].interfaceMode = 1;
	appPrefs[0].widgetHighlight = true;
	appPrefs[0].widgetShadow = true;
	appPrefs[0].widgetCornerRadius = 0; // 8 pixels
	appPrefs[0].useAnalogClockNumbers = 1; // Show numbers or lines in analog clock: 1 = true / 0 = false
	
	return prefs.set(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), 1);
}


// Delete preferences
void deletePrefs() {
	prefs.del(TimeBoard.creator, true);
}


handler TimeBoard.onstart() {
	// If there is no default prefs, set default prefs
	//if (getPrefs() == false)
		setDefaultPrefs();
	
	// Load the main form
	mainForm.load();
}
