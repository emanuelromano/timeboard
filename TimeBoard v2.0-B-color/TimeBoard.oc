	TimeBoard - A new clock app for Palm OS
	
	Written by @coloraturip
	
	VERSION 2.0.0 - Supports Palm OS 3.5 or newer
	
	Project started on March 13th, 2025
--------------------------------------------------------------- */

Preferences prefs;
Event e;
Date date;
Draw mainBuffer;
Draw draw;
const int numberOfPrefs = 4;
int colorDepth,
	appPrefsPosition;	// Determines which preferences will be used
						// according to the device's screen color depth.
						// 0: B/W screens (1-bit)
						// 1: Grayscale screens (2-bit)
						// 2: Grayscale screens (4-bit)
						// 3: Color screens (8-bit)

struct AppPrefs {
	bool debugFlag;
	
	// Background color
	int bgColorR;
	int bgColorG;
	int bgColorB;
	
	// Foreground color on widgets
	int fgColorR;
	int fgColorG;
	int fgColorB;
	
	// Highlight color on widgets
	int highlightR;
	int highlightG;
	int highlightB;
	
	// Base color on widgets
	int mainR;
	int mainG;
	int mainB;
	
	// Battery color between 100% - 50% charge 
	int batteryR;
	int batteryG;
	int batteryB;
	
	int batteryEmptyR;
	int batteryEmptyG;
	int batteryEmptyB;
	
	// Other preferences
	int interfaceMode;
	bool widgetHighlight;
	bool widgetShadow;
	int widgetCornerRadius;
	int useAnalogClockNumbers;
};

AppPrefs appPrefs[numberOfPrefs];


// Getting saved preferences
// Returns false if there is no stored preferences
bool getPrefs() {
	return prefs.get(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


// Set default preferences in case they do not exist
bool setDefaultPrefs() {
	bool debugFlag = false;
	int interfaceMode = 1,
		widgetCornerRadius = 4, // 8 pixels
		useAnalogClockNumbers = 1;	// Show numbers or lines in analog clock:
									// 1 = true
									// 0 = false
	
	// 0: B/W screens (1-bit)
	appPrefs[0].debugFlag = debugFlag;
	
	appPrefs[0].bgColorR = 255;
	appPrefs[0].bgColorG = 255;
	appPrefs[0].bgColorB = 255;
	
	appPrefs[0].fgColorR = 255;
	appPrefs[0].fgColorG = 255;
	appPrefs[0].fgColorB = 255;
	
	appPrefs[0].highlightR = 0;
	appPrefs[0].highlightG = 0;
	appPrefs[0].highlightB = 0;
	
	appPrefs[0].mainR = 0;
	appPrefs[0].mainG = 0;
	appPrefs[0].mainB = 0;
	
	appPrefs[0].batteryR = 0;
	appPrefs[0].batteryG = 0;
	appPrefs[0].batteryB = 0;
	
	appPrefs[0].batteryEmptyR = 0;
	appPrefs[0].batteryEmptyG = 0;
	appPrefs[0].batteryEmptyB = 0;
	
	appPrefs[0].interfaceMode = interfaceMode;
	appPrefs[0].widgetHighlight = false;
	appPrefs[0].widgetShadow = false;
	appPrefs[0].widgetCornerRadius = widgetCornerRadius;
	appPrefs[0].useAnalogClockNumbers = useAnalogClockNumbers;
		
	
	// 1: Grayscale screens (2-bit)
	appPrefs[1].debugFlag = debugFlag;
	
	appPrefs[1].bgColorR = 255;
	appPrefs[1].bgColorG = 255;
	appPrefs[1].bgColorB = 255;
	
	appPrefs[1].fgColorR = 128;
	appPrefs[1].fgColorG = 128;
	appPrefs[1].fgColorB = 128;
	
	appPrefs[1].highlightR = 0;
	appPrefs[1].highlightG = 0;
	appPrefs[1].highlightB = 0;
	
	appPrefs[1].mainR = 255;
	appPrefs[1].mainG = 255;
	appPrefs[1].mainB = 255;
	
	appPrefs[1].batteryR = 255;
	appPrefs[1].batteryG = 255;
	appPrefs[1].batteryB = 255;
	
	appPrefs[1].batteryEmptyR = 0;
	appPrefs[1].batteryEmptyG = 0;
	appPrefs[1].batteryEmptyB = 0;
	
	appPrefs[1].interfaceMode = interfaceMode;
	appPrefs[1].widgetHighlight = false;
	appPrefs[1].widgetShadow = false;
	appPrefs[1].widgetCornerRadius = widgetCornerRadius;
	appPrefs[1].useAnalogClockNumbers = useAnalogClockNumbers;
	
	
	// 2: Grayscale screens (4-bit)
	appPrefs[2].debugFlag = debugFlag;
	
	appPrefs[2].bgColorR = 255;
	appPrefs[2].bgColorG = 255;
	appPrefs[2].bgColorB = 255;
	
	appPrefs[2].fgColorR = 128;
	appPrefs[2].fgColorG = 128;
	appPrefs[2].fgColorB = 128;
	
	appPrefs[2].highlightR = 0;
	appPrefs[2].highlightG = 0;
	appPrefs[2].highlightB = 0;
	
	appPrefs[2].mainR = 255;
	appPrefs[2].mainG = 255;
	appPrefs[2].mainB = 255;
	
	appPrefs[2].batteryR = 255;
	appPrefs[2].batteryG = 255;
	appPrefs[2].batteryB = 255;
	
	appPrefs[2].batteryEmptyR = 0;
	appPrefs[2].batteryEmptyG = 0;
	appPrefs[2].batteryEmptyB = 0;
	
	appPrefs[2].interfaceMode = interfaceMode;
	appPrefs[2].widgetHighlight = false;
	appPrefs[2].widgetShadow = false;
	appPrefs[2].widgetCornerRadius = widgetCornerRadius;
	appPrefs[2].useAnalogClockNumbers = useAnalogClockNumbers;
	
	
	// 3: Color screens (8-bit)
	appPrefs[3].debugFlag = debugFlag;
	
	appPrefs[3].bgColorR = 51;
	appPrefs[3].bgColorG = 51;
	appPrefs[3].bgColorB = 51;
	
	appPrefs[3].fgColorR = 68;
	appPrefs[3].fgColorG = 68;
	appPrefs[3].fgColorB = 68;
	
	appPrefs[3].highlightR = 255;
	appPrefs[3].highlightG = 204;
	appPrefs[3].highlightB = 0;
	
	appPrefs[3].mainR = 255;
	appPrefs[3].mainG = 255;
	appPrefs[3].mainB = 255;
	
	appPrefs[3].batteryR = 102;
	appPrefs[3].batteryG = 255;
	appPrefs[3].batteryB = 0;
	
	appPrefs[3].batteryEmptyR = 120;
	appPrefs[3].batteryEmptyG = 120;
	appPrefs[3].batteryEmptyB = 120;
	
	appPrefs[3].interfaceMode = interfaceMode;
	appPrefs[3].widgetHighlight = true;
	appPrefs[3].widgetShadow = true;
	appPrefs[3].widgetCornerRadius = widgetCornerRadius;
	appPrefs[3].useAnalogClockNumbers = useAnalogClockNumbers;
	
	return prefs.set(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


// Delete preferences
void deletePrefs() {
	prefs.del(TimeBoard.creator, true);
	
	setDefaultPrefs();
}


handler TimeBoard.onstart() {
	int version = osver();
	
	// VALIDATIONS
	// Minimun OS version warning
	if (version < 50462720) {
    	alert("TimeBoard requires Palm OS 3.5 or higher.\nApp will exit.");
    	TimeBoard.abort();
	}
	
	// Get color depth supported by device at the moment
	colorDepth = TimeBoard.getdepth();
		
	switch (colorDepth) {
		case 1:
				appPrefsPosition = 0; // 0: B/W screens (1-bit)
				break;
		case 2:
				appPrefsPosition = 1; // 1: Grayscale screens (2-bit)
				break;
		case 4:
				appPrefsPosition = 2; // 2: Grayscale screens (4-bit)
				break;
		case 8:
				appPrefsPosition = 3; // 3: Color screens (8-bit)
				break;
		case 16:
				appPrefsPosition = 3; // 3: Color screens (8-bit)
				break;
		default:
				appPrefsPosition = 3; // 3: Color screens (8-bit)
				break;
	}
	
	// If there is no default prefs, set default prefs
	//if (getPrefs() == false)
		setDefaultPrefs();
	
	// Load the main form
	mainForm.load();
}
