// Round coordinates for drawing and angles
int roundCoord(float value) {
    if (value >= 0)
        return (int)(value + 0.5);
    else
        return (int)(value - 0.5);
}


// Draws hand with given parameters
void drawHand(float angle,
			  int length,
			  int centerX,
			  int centerY,
			  int r,
			  int g,
			  int b,
			  bool isSecond)
{
	int x, y;
	
	mainBuffer.begin();
	mainBuffer.fgRGB(r, g, b);

	x = centerX + roundCoord(cos(angle) * length);
	y = centerY + roundCoord(sin(angle) * length);

	mainBuffer.line(clrFG, centerX, centerY, x, y);
	
	// Little dot on the end of hands
	if (widgetW != 70 && !isSecond) mainBuffer.rect(clrFG, x-1, y-1, x+2, y+2, 2);
	
	mainBuffer.end();
}


void updateClockHands() {
	int i, x, y,
		axisXcorrection = 0,
		circleRadius,
		bgColorR, bgColorG, bgColorB,
		colorR, colorG, colorB;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (widgetW != 70) {
		axisXcorrection = 27;
		secondLength = 14;
	}
	
	// Color switch
	if (colorDepth > 4) {
		bgColorR = fgColorR;
		bgColorG = fgColorG;
		bgColorB = fgColorB;
		
		colorR = mainR;
		colorG = mainG;
		colorB = mainB;
	}
	else
	{
		if (colorDepth == 1) {
			bgColorR = fgColorR;
			bgColorG = fgColorG;
			bgColorB = fgColorB;
		}
		else
		{
			bgColorR = mainR;
			bgColorG = mainR;
			bgColorB = mainR;
		}
		
		colorR = highlightR;
		colorG = highlightG;
		colorB = highlightB;
	}
	
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	true);
		
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	false);
	
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	// TimeBoard text on big widget
	if (widgetW != 70) {
		mainBuffer.begin();
		mainBuffer.textRGB(highlightR, highlightG, highlightB);
		
		if (colorDepth > 4 || colorDepth == 1)
    		mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
    	else
    		mainBuffer.bgRGB(mainR, mainG, mainB);
		
		mainBuffer.textAlign(11);
		mainBuffer.font(fntBold);
		mainBuffer.text(clrText, centerX-36, centerY-2, " TimeBoard");
		
		// Small circle for seconds
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG, (centerX + axisXcorrection)-17, centerY-17, (centerX + axisXcorrection)+18, centerY+18, 18, 1);
		
		// Center
		mainBuffer.rect(clrFG, (centerX + axisXcorrection)-2, centerY-2, (centerX + axisXcorrection)+3, centerY+3, 3);
		
		// 12 dots (every 5 seconds)
		circleRadius = 16;
		for (i = 0; i < 12; i++) {
			angle = ((i * 30) - 90) * 3.14159265 / 180;
		
			x = (centerX + axisXcorrection) + roundCoord(cos(angle) * circleRadius);
			y = centerY + roundCoord(sin(angle) * circleRadius);
			
			if (colorDepth > 4)
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    		else
    			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
			
			mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Color switch
	if (colorDepth > 4) {
		colorR = mainR;
		colorG = mainG;
		colorB = mainB;
	}
	else
	{
		colorR = highlightR;
		colorG = highlightG;
		colorB = highlightB;
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
		
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
			 	
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
	}
	
	// Hand centre circle size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fgRGB(colorR, colorG, colorB);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius;
	float angle;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	radius = (widgetW / 2) - (widgetW / 2) * 0.26;
	
	// Hands lenght
	hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
	minuteLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	secondLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	
	mainBuffer.begin();
	
	// Big circle around clock
	if (widgetW != 70) {
		circleSeparation = 66;
		circleCornerRadius = 66;
		secondDotRadius = 63;
		
		if (colorDepth == 2 || colorDepth == 4) {
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.rect(clrFG,
							centerX-circleSeparation,
							centerY-circleSeparation,
							centerX+circleSeparation,
							centerY+circleSeparation,
							circleCornerRadius);
		}
		
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
		
		// Minutes dots
		if (colorDepth > 4)
			mainBuffer.fgRGB(mainR, mainG, mainB);
		else
			mainBuffer.fgRGB(highlightR, highlightR, highlightR);
		
		for (i = 0; i < 60; i++) {
		
			angle = ((i * 6) - 90) * 3.14159265 / 180;
		
			x = centerX + roundCoord(cos(angle) * secondDotRadius);
			y = centerY + roundCoord(sin(angle) * secondDotRadius) - 1;
		
			mainBuffer.pixel(clrFG, x, y);
		}
		
		// "TimeBoard" text on big widget
		/*mainBuffer.textRGB(highlightR, highlightG, highlightB);
		mainBuffer.textAlign(11);
		mainBuffer.font(fntLargeBold);
		mainBuffer.text(clrText, centerX, centerY-28, "TimeBoard");*/
	}
	else
	{
		// Small circle around clock on small widget
		circleSeparation = 31;
		circleCornerRadius = 31;
		
		// White background
		if (colorDepth == 2 || colorDepth == 4) {
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.rect(clrFG,
							centerX-circleSeparation,
							centerY-circleSeparation,
							centerX+circleSeparation,
							centerY+circleSeparation,
							circleCornerRadius);
		}
	}
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
			// Font size difference according to widget
			if (widgetW == 70) {
				mainBuffer.font(fntStandard);
			}
			else
			{
				mainBuffer.font(fntLarge);
			}
			
			// Color switch
			if (colorDepth == 2 || colorDepth == 4) {
				mainBuffer.bgRGB(mainR, mainG, mainB);
    			mainBuffer.textRGB(highlightR, highlightG, highlightB);
    		}
    		else
    		{
    			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetW / 2) * 0.66;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetW / 2) * 0.70;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			if (colorDepth > 4 || colorDepth ==1)
					mainBuffer.fgRGB(mainR, mainG, mainB);
				else
					mainBuffer.fgRGB(highlightR, highlightG, highlightB);
				
    			if (widgetW != 70) {
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			}
    			else
    			{
    				mainBuffer.pixel(clrFG, x2, y2);
    			}
    		}
		}
	}
	
	// Small circle around clock on small widget
	if (widgetW == 70) {
		circleSeparation = 31;
		circleCornerRadius = 31;
				
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	
	
	}
	
	updateClockHands();
	mainBuffer.end();
}


void updateClockHands2() {
	int i, x, y,
		axisXcorrection = 0,
		axisYcorrection = 0,
		circleRadius,
		bgColorR, bgColorG, bgColorB,
		colorR, colorG, colorB;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (interfaceMode == 1) {
		axisXcorrection = 70;
		axisYcorrection = 0;
		secondLength = 16;
	}
	
	// Color switch
	if (colorDepth > 4) {
		bgColorR = fgColorR;
		bgColorG = fgColorG;
		bgColorB = fgColorB;
		
		colorR = mainR;
		colorG = mainG;
		colorB = mainB;
	}
	else
	{
		if (colorDepth == 1) {
			bgColorR = fgColorR;
			bgColorG = fgColorG;
			bgColorB = fgColorB;
		}
		else
		{
			bgColorR = mainR;
			bgColorG = mainR;
			bgColorB = mainR;
		}
		
		colorR = highlightR;
		colorG = highlightG;
		colorB = highlightB;
	}
	
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	true);
		
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	false);
	
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	bgColorR,
			 	bgColorG,
			 	bgColorB,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	if (widgetW != 70) {
		mainBuffer.begin();
		// White circle for background
		if (colorDepth == 2 || colorDepth == 4) {
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.rect(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21);
		}
		
		// Small circle for seconds
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG, (centerX+axisXcorrection)-20, (centerY+axisYcorrection)-20, (centerX+axisXcorrection)+21, (centerY+axisYcorrection)+21, 21, 1);
		
		// Center
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-2, (centerY+axisYcorrection)-2, (centerX+axisXcorrection)+3, (centerY+axisYcorrection)+3, 3);
		
		// 12 dots (every 5 seconds)
		circleRadius = 19;
		
		for (i = 0; i < 12; i++) {
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
		
    		x = (centerX + axisXcorrection) + roundCoord(cos(angle) * circleRadius);
    		y = (centerY + axisYcorrection) + roundCoord(sin(angle) * circleRadius);
			
			if (colorDepth > 4)
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    		else
    			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		
    		mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Draw new hands (drawing order changes depending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
		
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	colorR,
			 	colorG,
			 	colorB,
			 	false);
			 	
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
	}
	
	// Hand circle size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fgRGB(colorR, colorG, colorB);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget2(int startX, int startY) {
