// Round coordinates for drawing and angles
int roundCoord(float value) {
    if (value >= 0)
        return (int)(value + 0.5);
    else
        return (int)(value - 0.5);
}


// Draws hand with given parameters
void drawHand(float angle,
			  int length,
			  int centerX,
			  int centerY,
			  int r,
			  int g,
			  int b,
			  bool isSecond)
{
	int x, y;
	
	mainBuffer.begin();
	mainBuffer.fgRGB(r, g, b);

	x = centerX + roundCoord(cos(angle) * length);
	y = centerY + roundCoord(sin(angle) * length);

	mainBuffer.line(clrFG, centerX, centerY, x, y);
	// Little dot on the end of hands
	if (widgetW != 70 && !isSecond) mainBuffer.rect(clrFG, x-1, y-1, x+2, y+2, 2); 
	mainBuffer.end();
}


void updateClockHands() {
	int i, x, y,
		axisYcorrection = 0,
		circleRadius;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (widgetW != 70) {
		axisYcorrection = 26;
		secondLength = 14;
	}
	
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX,
			 	centerY + axisYcorrection,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	true);
		
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	false);
	
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	// TimeBoard text on big widget
	if (widgetW != 70) {
		mainBuffer.begin();
		mainBuffer.textRGB(highlightR, highlightG, highlightB);
		mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
		mainBuffer.textAlign(11);
		mainBuffer.font(fntLargeBold);
		mainBuffer.text(clrText, centerX, centerY-28, "TimeBoard");
	
		// Small circle for seconds
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG, centerX-17, centerY+9, centerX+18, centerY+44, 18, 1);
		// Center
		//mainBuffer.pixel(clrFG, centerX, centerY+26);
		mainBuffer.rect(clrFG, centerX-2, centerY+24, centerX+3, centerY+29, 3);
		
		// 6 dots (every 10 seconds)
		circleRadius = 16;
		for (i = 0; i < 6; i++) {
		
			// 0 = 12 o'clock
			angle = ((i * 60) - 90) * 3.14159265 / 180;
		
			x = centerX + roundCoord(cos(angle) * circleRadius);
			y = (centerY + axisYcorrection) + roundCoord(sin(angle) * circleRadius);
			
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Draw new hands (drawing order changes deppending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX,
			 	centerY + axisYcorrection,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
		
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
			 	
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX,
			 	centerY + axisYcorrection,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
	}

		
	// Hand circle size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fgRGB(mainR, mainG, mainB);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius;
	float angle;
	string number;
	
	centerX = startX + (widgetW / 2);
	centerY = startY + (widgetH / 2);
	
	radius = (widgetW / 2) - (widgetW / 2) * 0.26;
	
	// Hands lenght
	hourLength = (widgetW / 2) - (widgetW / 2) * 0.55;
	minuteLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	secondLength = (widgetW / 2) - (widgetW / 2) * 0.41;
	
	mainBuffer.begin();	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
			// Font size difference according to widget
			if (widgetW == 70) {
				mainBuffer.font(fntStandard);
			}
			else
			{
				mainBuffer.font(fntLarge);
			}
			
			// Color for 3, 6, 9 & 12 numbers
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		else
    		{
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetW / 2) * 0.66;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetW / 2) * 0.70;
    			outerRadius = (widgetW / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    			if (widgetW != 70) {
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			}
    			else
    			{
    				mainBuffer.pixel(clrFG, x2, y2);
    			}
    		}
		}
	}
	
	// Big circle around clock
	if (widgetW != 70) {
		circleSeparation = 66;
		circleCornerRadius = 66;
		secondDotRadius = 63;
		
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
		
		// Seconds dots
		mainBuffer.fgRGB(mainR, mainG, mainB);
		
		for (i = 0; i < 60; i++) {
		
			angle = ((i * 6) - 90) * 3.14159265 / 180;
		
			x = centerX + roundCoord(cos(angle) * secondDotRadius);
			y = centerY + roundCoord(sin(angle) * secondDotRadius) - 1;
		
			mainBuffer.pixel(clrFG, x, y);
		}
		
		// "TimeBoard" text on big widget
		mainBuffer.textRGB(highlightR, highlightG, highlightB);
		mainBuffer.textAlign(11);
		mainBuffer.font(fntLargeBold);
		mainBuffer.text(clrText, centerX, centerY-28, "TimeBoard");
	}
	else
	{
		// Small circle around clock on small widget
		circleSeparation = 31;
		circleCornerRadius = 31;
		
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	}
		
	updateClockHands();
	mainBuffer.end();
}


void updateClockHands2() {
	int i, x, y,
		axisXcorrection = 0,
		axisYcorrection = 0,
		circleRadius;
	float angle,
		newHourAngle,
		newMinuteAngle,
		newSecondAngle;
	
	if (interfaceMode != 0) {
		axisXcorrection = 70;
		axisYcorrection = 10;
		secondLength = 16;
	}
	
	// Delete old hands
	if (oldHourAngle != 0) {
		drawHand(oldSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	true);
		
		drawHand(oldHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	false);
	
		drawHand(oldMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	fgColorR,
			 	fgColorG,
			 	fgColorB,
			 	false);
	}
	
	// Calculate new angles	
	newHourAngle =
		((float)(hours % 12) * 30 + (float)minutes / 2 - 90) / 180 * pi;
	newMinuteAngle =
		((float)minutes * 6 - 90) / 180 * pi;
	newSecondAngle =
		((float)seconds * 6 - 90) / 180 * pi;
	
	if (widgetW != 70) {
		mainBuffer.begin();
		// Small circle for seconds
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG, (centerX+axisXcorrection)-20, centerY-10, (centerX+axisXcorrection)+21, centerY+31, 21, 1);
		// Center
		//mainBuffer.pixel(clrFG, centerX, centerY+26);
		mainBuffer.rect(clrFG, (centerX+axisXcorrection)-2, (centerY+axisYcorrection)-2, (centerX+axisXcorrection)+3, (centerY+axisYcorrection)+3, 3);
		
		// 6 dots (every 10 seconds)
		circleRadius = 19;
		for (i = 0; i < 6; i++) {
		
			// 0 = 12 o'clock
			angle = ((i * 60) - 90) * 3.14159265 / 180;
		
			x = (centerX + axisXcorrection) + roundCoord(cos(angle) * circleRadius);
			y = (centerY + 10) + roundCoord(sin(angle) * circleRadius);
			
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.pixel(clrFG, x, y);
		}
		mainBuffer.end();
	}
	
	// Draw new hands (drawing order changes deppending on widget size)
	if (widgetW != 70) {
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY + axisYcorrection,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
		
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
	}
	else
	{
		drawHand(newHourAngle,
			 	hourLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
		
		drawHand(newMinuteAngle,
			 	minuteLength,
			 	centerX,
			 	centerY,
			 	mainR,
			 	mainG,
			 	mainB,
			 	false);
			 	
		drawHand(newSecondAngle,
			 	secondLength,
			 	centerX + axisXcorrection,
			 	centerY,
			 	highlightR,
			 	highlightG,
			 	highlightB,
			 	true);
	}

		
	// Hand circle size according to widget size
	mainBuffer.begin();
	if (widgetW != 70) {
		mainBuffer.fgRGB(mainR, mainG, mainB);
		mainBuffer.rect(clrFG,
			centerX - 3,
			centerY - 3,
			centerX + 4,
			centerY + 4,
			4);
	}
	else
	{
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.rect(clrFG,
			centerX - 2,
			centerY - 2,
			centerX + 3,
			centerY + 3,
			3);
	}
	mainBuffer.end();
	
	// Save for next draw in buffer
	oldHourAngle = newHourAngle;
	oldMinuteAngle = newMinuteAngle;
	oldSecondAngle = newSecondAngle;
}


void analogClockWidget2(int startX, int startY) {
	int i,
		x, y,
		radius,
		innerRadius,
		outerRadius,
		x1, y1,
		x2, y2,
		circleSeparation,
		circleCornerRadius,
		secondDotRadius;
	float angle;
	string number;
	
	centerX = startX + (widgetW / 2) - 30;
	centerY = startY + (widgetH / 2);
	
	radius = (widgetH / 2) - (widgetH / 2) * 0.28;
	
	// Hands lenght
	hourLength = (widgetH / 2) - (widgetH / 2) * 0.55;
	minuteLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	secondLength = (widgetH / 2) - (widgetH / 2) * 0.41;
	
	mainBuffer.begin();	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
			// Font size difference according to widget
			if (widgetW == 70) {
				mainBuffer.font(fntStandard);
			}
			else
			{
				mainBuffer.font(fntStandard);
			}
			
			// Color for 3, 6, 9 & 12 numbers
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		else
    		{
    			mainBuffer.textRGB(mainR, mainG, mainB);
    		}
    		
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetH / 2) * 0.66;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetH / 2) * 0.70;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    			if (widgetW != 70) {
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			}
    			else
    			{
    				mainBuffer.pixel(clrFG, x2, y2);
    			}
    		}
		}
	}
	
	// Big circle around clock
	if (widgetH != 70) {
		circleSeparation = 38;
		circleCornerRadius = 38;
		secondDotRadius = 36;
		
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
		
		// Seconds dots
		mainBuffer.fgRGB(mainR, mainG, mainB);
		
		for (i = 0; i < 60; i++) {
		
			angle = ((i * 6) - 90) * 3.14159265 / 180;
		
			x = centerX + roundCoord(cos(angle) * secondDotRadius);
