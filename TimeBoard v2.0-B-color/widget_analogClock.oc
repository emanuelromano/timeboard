		circleSeparation = 31;
		circleCornerRadius = 31;
		
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.frame(clrFG,
						centerX-circleSeparation,
						centerY-circleSeparation,
						centerX+circleSeparation,
						centerY+circleSeparation,
						circleCornerRadius,
						1);
	}
	
	if (useAnalogClockNumbers == 1) {
		// Clock numbers
		for (i = 0; i < 12; i++) {
	
			// 0 = 12 upwards
			angle = ((i * 30) - 90) * 3.14159265 / 180;
	
			x = centerX + roundCoord(cos(angle) * radius);
			y = centerY + roundCoord(sin(angle) * radius) - 1;
	
			if (i == 0)
				number = "12";
			else
				number = "" + i;
						
			// Centered text, font and color
			mainBuffer.textAlign(11);
			mainBuffer.font(fntStandard);
			
			if (colorDepth > 4) {
				mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
				mainBuffer.textRGB(mainR, mainG, mainB);
			}
			else
			{
				if (colorDepth == 1) {
					mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
				}
				else
				{
					mainBuffer.bgRGB(mainR, mainG, mainG);
				}
				
				mainBuffer.textRGB(highlightR, highlightG, highlightB);
			}
			
			mainBuffer.text(clrText, x, y, number);
		}
	}
	else
	{
		// Clock lines
		for (i = 0; i < 12; i++) {
			if (i == 0 || i == 3 || i == 6 || i == 9) {
    			// Longer lines
    			innerRadius = (widgetH / 2) * 0.66;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			else {
    			// Shorter lines
    			innerRadius = (widgetH / 2) * 0.70;
    			outerRadius = (widgetH / 2) * 0.80;
			}
			
    		// 0 = 12 o'clock
    		angle = ((i * 30) - 90) * 3.14159265 / 180;
			
			x1 = centerX + roundCoord(cos(angle) * innerRadius);
			y1 = centerY + roundCoord(sin(angle) * innerRadius);
			
			x2 = centerX + roundCoord(cos(angle) * outerRadius);
			y2 = centerY + roundCoord(sin(angle) * outerRadius);
    		    		
    		// Color for 3, 6, 9 & 12 lines
    		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
    		if (i == 0) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2-1, y2+1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1-1, x2+1, y2+1);
    		}
    		else if (i == 3) {
    			mainBuffer.line(clrFG, x1+1, y1-1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2-1, y2+1);
    		}
    		else if (i == 6) {
    			mainBuffer.line(clrFG, x1-1, y1+1, x2-1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1+1, y1+1, x2+1, y2-1);
    		}
    		else if (i == 9) {
    			mainBuffer.line(clrFG, x1-1, y1-1, x2+1, y2-1);
    			mainBuffer.line(clrFG, x1, y1, x2, y2);
    			mainBuffer.line(clrFG, x1-1, y1+1, x2+1, y2+1);
    		}
    		else
    		{
    			mainBuffer.fgRGB(mainR, mainG, mainB);
    			if (widgetW != 70)
    				mainBuffer.rect(clrFG, x2-1, y2-1, x2+2, y2+2, 2);
    			else
    				mainBuffer.pixel(clrFG, x2, y2);
    		}
		}
	}
	
	updateClockHands2();
	mainBuffer.end();
}
