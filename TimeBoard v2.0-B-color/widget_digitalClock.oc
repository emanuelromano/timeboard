void digitalClockWidget(int startX, int startY) {
	int digitHr1X = startX + 8,
		digitHr2X = startX + 25,
		
		digitMin1X = startX + 8,
		digitMin2X = startX + 25,
		
		digitY1 = startY + 8,
		digitY2 = startY + 37,
		
		digitW = 14,
		digitH = 26,
		radius = 2,
		segmentThickness = 4;
	
	splitTimeDigits();
	
	mainBuffer.begin();
	//if (minutes != lastMinute) {
		// Hour
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		// drawDigit() comes from globalFunctions.oc
		drawDigit(hourDigit1, digitW, digitH, digitHr1X, digitY1, radius, segmentThickness);
		drawDigit(hourDigit2, digitW, digitH, digitHr2X, digitY1, radius, segmentThickness);
		
		// Minutes
		mainBuffer.fgRGB(mainR, mainG, mainB);
		drawDigit(minuteDigit1, digitW, digitH, digitMin1X, digitY2, radius, segmentThickness);
		drawDigit(minuteDigit2, digitW, digitH, digitMin2X, digitY2, radius, segmentThickness);
		
		// AP/PM
		/*mainBuffer.textAlign(00);
		mainBuffer.textRGB(highlightR, highlightG, highlightB);
		mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
		mainBuffer.font(fntLargeBold);
		mainBuffer.text(clrText, digitHr1X, digitY+digitH, "p.m.");*/
	//}
	
	// Seconds
	mainBuffer.textAlign(22);
	mainBuffer.textRGB(mainR, mainG, mainB);
	mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+widgetW-7, startY+widgetH-7, "   " + secondDigit1 + "" + secondDigit2);
	mainBuffer.end();
}


void miniDigitalClockWidget(int startX, int startY) {
	int digitX, digitY;
	
	digitX = startX + (miniPanelW / 2);
	digitY = startY + (miniPanelH / 2);
	
	splitTimeDigits();
	
	mainBuffer.begin();
	mainBuffer.textAlign(11);
	mainBuffer.textRGB(highlightR, highlightG, highlightB);
	// Hour
	mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.font(fntLED);
	mainBuffer.text(clrText, digitX-8, digitY-11, hourDigit1 + "" + hourDigit2);
	// Dots
	mainBuffer.fgRGB(mainR, mainG, mainB);
	mainBuffer.rect(clrFG, digitX-14, digitY-1, digitX-12, digitY+1, 2);
	mainBuffer.rect(clrFG, digitX-5, digitY-1, digitX-3, digitY+1, 2);
	// Minutes
	mainBuffer.textRGB(mainR, mainG, mainB);
	mainBuffer.text(clrText, digitX-8, digitY+11, minuteDigit1 + "" + minuteDigit2);
	// Seconds
	mainBuffer.font(fntStandard);
	mainBuffer.text(clrText, digitX+13, digitY+13, secondDigit1 + "" + secondDigit2);
	mainBuffer.end();
}
