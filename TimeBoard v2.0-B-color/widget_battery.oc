void drawBatteryDots(int startX, int startY, int widW, int widH, int dotRadius, int ringRadius, int charge) {
	int centerX, centerY,
		activeDots,
		i, x, y,
		activeR, activeG, activeB;
	float angle;

	centerX = startX + (widW / 2);
	centerY = startY + (widH / 2);

	activeDots = charge / 10;

	if (activeDots > 10)
		activeDots = 10;

	if (activeDots < 0)
		activeDots = 0;

	// Battery color
	if (colorDepth > 4) {
		if (charge > 40) {
			// Green
			activeR = batteryR;
			activeG = batteryG;
			activeB = batteryB;
		}
		else if (charge > 20) {
			// Orange
			activeR = 255;
			activeG = 153;
			activeB = 0;
		}
		else
		{
			// Red
			activeR = 255;
			activeG = 0;
			activeB = 0;
		}
	}
	else
	{
		activeR = batteryR;
		activeG = batteryG;
		activeB = batteryB;
	}

	for (i = 0; i < 10; i++) {

		angle = ((i * 36) - 90) * 3.14159265 / 180;

		x = centerX + (cos(angle) * ringRadius);
		y = centerY + (sin(angle) * ringRadius);

		if (i < activeDots) {
			mainBuffer.fgRGB(activeR, activeG, activeB);
			
			mainBuffer.rect(
			clrFG,
			x - dotRadius,
			y - dotRadius,
			x + dotRadius,
			y + dotRadius,
			dotRadius);
		}
		else
		{
			if (colorDepth > 4) {
				mainBuffer.fgRGB(batteryEmptyR, batteryEmptyG, batteryEmptyB); // Color discharged grey
				
				mainBuffer.rect(
				clrFG,
				x - dotRadius,
				y - dotRadius,
				x + dotRadius,
				y + dotRadius,
				dotRadius);
			}
			else
			{
				if (colorDepth == 1) {
					mainBuffer.fgRGB(activeR, activeG, activeB); // B/W discharged empty circles
					
					mainBuffer.frame(
					clrFG,
					x - (dotRadius-1),
					y - (dotRadius-1),
					x + (dotRadius),
					y + (dotRadius),
					dotRadius,
					1);
				}
				else
				{
					mainBuffer.fgRGB(batteryEmptyR, batteryEmptyG, batteryEmptyB); // Gray discharged grey
					
					mainBuffer.rect(
					clrFG,
					x - dotRadius,
					y - dotRadius,
					x + dotRadius,
					y + dotRadius,
					dotRadius);
				}
			}
		}
	}
}


void batteryWidget(int startX, int startY) {
	int dotRadius = 4,
		ringRadius = 18,
		
		iconX = startX + 7,
		iconY = startY + 55,
		
		digitY = startY + 52;
	
	mainBuffer.begin();
	// Battery dots
	drawBatteryDots(startX, startY, widgetW, widgetH-13, dotRadius, ringRadius, charge);
	
	// Battery icon
	
	
	
	if (colorDepth > 4 || colorDepth == 1)
		mainBuffer.fgRGB(mainR, mainG, mainB);
	else
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
	
	mainBuffer.frame(clrFG, iconX, iconY, iconX+15, iconY+8, 2, 1);
	mainBuffer.line(clrFG, iconX+16, iconY+2, iconX+16, iconY+5);
	
	mainBuffer.fgRGB(highlightR, highlightG, highlightB);
	mainBuffer.rect(clrFG, iconX+1, iconY+1, iconX+14, iconY+7, 1);
	
	// Battery percentage
	mainBuffer.textAlign(02);
	mainBuffer.textRGB(mainR, mainG, mainB);
	mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.font(fntLargeBold);
	mainBuffer.text(clrText, startX+65, digitY, "   "+charge+"%");
	mainBuffer.end();
}


