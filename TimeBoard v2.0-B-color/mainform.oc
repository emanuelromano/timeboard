void composeBackgroundBuffer() {
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
	
	mainBuffer.begin();
	
	// Draw background
	mainBuffer.fgRGB(bgColorR, bgColorG, bgColorB);
	mainBuffer.rect(clrFG, mainForm.x, mainForm.y, mainForm.w, mainForm.h, 0);
	
	// Set & calculate colors
	mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
	
	if (colorDepth > 4) {
		calculateShadowColor(100);
		calculateHighlightColor(50);
	}
	
	mainBuffer.bgRGB(bgShadowColorR, bgShadowColorG, bgShadowColorB);
	
	if (showWidget1) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX1+1, startY1+1, startX1+widgetW+1, startY1+widgetH+1, widgetCornerRadius);
		
		// Main rectangle
		if (colorDepth > 4) {
			mainBuffer.rect(clrFG, startX1, startY1, startX1+widgetW, startY1+widgetH, widgetCornerRadius);
		}
		else
		{
			if (widgetCornerRadius == 0)
				auxWidgetCornerRadius = 1;
			else
				auxWidgetCornerRadius = widgetCornerRadius;
			
			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
			mainBuffer.rect(clrFG, startX1, startY1, startX1+widgetW+1, startY1+widgetH+1, widgetCornerRadius);
			mainBuffer.fgRGB(fgColorR, fgColorR, fgColorR);
			mainBuffer.rect(clrFG, startX1+1, startY1+1, startX1+widgetW-1, startY1+widgetH-1, auxWidgetCornerRadius-1);
		}
		
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX1, startY1, widgetW, widgetH);
		}
	
	if (showWidget2) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX2+1, startY2+1, startX2+widgetW+1, startY2+widgetH+1, widgetCornerRadius);
		
		// Main rectangle
		if (colorDepth > 4) {
			mainBuffer.rect(clrFG, startX2, startY2, startX2+widgetW, startY2+widgetH, widgetCornerRadius);
		}
		else
		{
			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
			mainBuffer.rect(clrFG, startX2, startY2, startX2+widgetW+1, startY2+widgetH+1, widgetCornerRadius);
			mainBuffer.fgRGB(fgColorR, fgColorR, fgColorR);
			mainBuffer.rect(clrFG, startX2+1, startY2+1, startX2+widgetW-1, startY2+widgetH-1, auxWidgetCornerRadius-1);
		}
				
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX2, startY2, widgetW, widgetH);
		}
	
	if (showWidget3) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX3+1, startY3+1, startX3+widgetW+1, startY3+widgetH+1, widgetCornerRadius);
		
		// Main rectangle
		if (colorDepth > 4) {
			mainBuffer.rect(clrFG, startX3, startY3, startX3+widgetW, startY3+widgetH, widgetCornerRadius);
		}
		else
		{
			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
			mainBuffer.rect(clrFG, startX3, startY3, startX3+widgetW+1, startY3+widgetH+1, widgetCornerRadius);
			mainBuffer.fgRGB(fgColorR, fgColorR, fgColorR);
			mainBuffer.rect(clrFG, startX3+1, startY3+1, startX3+widgetW-1, startY3+widgetH-1, auxWidgetCornerRadius-1);
		}
				
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX3, startY3, widgetW, widgetH);
		}
	
	if (showWidget4) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX4+1, startX4+1, startX4+widgetW+1, startY4+widgetH+1, widgetCornerRadius);
		
		// Main rectangle
		if (colorDepth > 4) {
			mainBuffer.rect(clrFG, startX4, startY4, startX4+widgetW, startY4+widgetH, widgetCornerRadius);
		}
		else
		{
			mainBuffer.fgRGB(highlightR, highlightG, highlightB);
			mainBuffer.rect(clrFG, startX4, startY4, startX4+widgetW+1, startY4+widgetH+1, widgetCornerRadius);
			mainBuffer.fgRGB(fgColorR, fgColorR, fgColorR);
			mainBuffer.rect(clrFG, startX4+1, startY4+1, startX4+widgetW-1, startY4+widgetH-1, auxWidgetCornerRadius-1);
		}
				
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX4, startY4, widgetW, widgetH);
		}
	
	mainBuffer.end();
}


void composeWidgetsBuffer() {
	if (showWidget1)
		if (interfaceMode == 0)
			analogClockWidget(startX1, startY1);
		if (interfaceMode == 1)
			analogClockWidget2(startX1, startY1);
	
	if (showWidget2) digitalClockWidget(startX2, startY2);
	if (showWidget3) calendarWidget(startX3, startY3);
	if (showWidget4) batteryWidget(startX4, startY4);
}


handler mainForm.onopen() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
	
	setMainPreferences();
	
	date.now();
	year = date.year;
	month = date.month;
	day = date.day;
	weekday = date.weekday;

	hours = date.hour;
	minutes = date.min;
	seconds = date.sec;
	
	charge = battery(false);
	
	// Corner radius for font segments
	fontRadius = 2;
	
	timer(1);
}


handler mainForm.ondraw() {
	showWidget1 = false;
	showWidget2 = false;
	showWidget3 = false;
	showWidget4 = false;
	
	falseZero = false;
	
	if (mainForm.h > 160) {
		// Portrait mode
		showWidget1 = true;
		
		interfaceMode = 0; // Force interfaceMode to 0 for fullscreen modes
		falseZero  = true;
		
		widgetW = 144;
		widgetH = 154;
		
		miniPanelX1 = 14;
		miniPanelY1 = 173;
		
		miniPanelX2 = 61;
		miniPanelY2 = 173;
		
		miniPanelX3 = 108;
		miniPanelY3 = 173;
		
		miniPanelW = 38;
		miniPanelH = 38;
		
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the bottom
		orientation = "P"; // Portrait
		drawAuxiliarPanel(orientation);
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else if (mainForm.w > 160) {
		// Landscape mode
		showWidget1 = true;
		
		interfaceMode = 0; // Force interfaceMode to 0 for fullscreen modes
		falseZero  = true;
		
		widgetW = 154;
		widgetH = 144;
		
		miniPanelX1 = 173;
		miniPanelY1 = 15;
		
		miniPanelX2 = 173;
		miniPanelY2 = 62;
		
		miniPanelX3 = 173;
		miniPanelY3 = 109;
		
		miniPanelW = 38;
		miniPanelH = 38;
		
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the side
		orientation = "L"; // Landscape
		drawAuxiliarPanel(orientation);
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else
	{
		// Normal mode (square display)
		interfaceMode = appPrefs[appPrefsPosition].interfaceMode;
		
		if (interfaceMode == 1) {
			showWidget1 = true;
			
			widgetW = 144;
			widgetH = 89;
			
			miniPanelX1 = 14;
			miniPanelY1 = 108;
			
			miniPanelX2 = 61;
			miniPanelY2 = 108;
			
			miniPanelX3 = 108;
			miniPanelY3 = 108;
			
			miniPanelW = 38;
			miniPanelH = 38;
			
			composeBackgroundBuffer();
			composeWidgetsBuffer();
			
			// Big widget background pannel
			mainBuffer.begin();
			mainBuffer.textRGB(highlightR, highlightG, highlightB);
			mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
			mainBuffer.font(fntBold);
			//mainBuffer.textAlign(02);
			//mainBuffer.text(clrText, mainForm.w-14, mainForm.y+13, "/////////");
			mainBuffer.textAlign(22);
			mainBuffer.text(clrText, mainForm.w-14, mainForm.y+widgetH+1, "TimeBoard");
			mainBuffer.end();
		
			orientation = "N"; // Normal (square)
			drawAuxiliarPanel(orientation);
			
			// Mini widgets
			miniDigitalClockWidget(miniPanelX1, miniPanelY1);
			miniCalendarWidget(miniPanelX2, miniPanelY2);
			miniBatteryWidget(miniPanelX3, miniPanelY3);
		}
		else
		{
			showWidget1 = true;
			showWidget2 = true;
			showWidget3 = true;
			showWidget4 = true;
			
			widgetW = 70;
			widgetH = 70;
			
			composeBackgroundBuffer();
			composeWidgetsBuffer();
		}
	}
	
	// Draw mainBuffer
	drawMainBuffer();
}


handler mainForm.ontimer() {
	date.now();
	seconds = date.sec;
	
	if (!mainForm.obscured && seconds != lastSecond) {
		year = date.year;
		month = date.month;
		day = date.day;
		weekday = date.weekday;
	
		hours = date.hour;
		minutes = date.min;
		
		charge = battery(false);
		
		// Widgets
		if (showWidget1)
			if (interfaceMode == 0)
				updateClockHands();
			if (interfaceMode == 1)
				updateClockHands2();
		
		if (showWidget2)
			digitalClockWidget(startX2, startY2);
		else
			if (interfaceMode == 1 || falseZero)
				miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		
		if (showWidget3)
			if (day != lastDay)
				calendarWidget(startX3, startY3);
		else
			if (interfaceMode == 1 || falseZero)
				miniCalendarWidget(miniPanelX2, miniPanelY2);
		
		if (showWidget4)
			if (charge != lastCharge)
				batteryWidget(startX4, startY4);
		else
			if (interfaceMode == 1 || falseZero)
				miniBatteryWidget(miniPanelX3, miniPanelY3);
		
		// Draw mainBuffer
		drawMainBuffer();
	}
	
	lastSecond = seconds;
	lastMinute = minutes;
	lastDay = day;
	lastCharge = charge;
	timer(20);
}


handler mainForm.onresize() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
}


