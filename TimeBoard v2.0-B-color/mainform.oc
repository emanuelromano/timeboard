void setMainPreferences() {
	// Set UI colors
	bgColorR = appPrefs[0].bgColorR;
	bgColorG = appPrefs[0].bgColorG;
	bgColorB = appPrefs[0].bgColorB;
	
	fgColorR = appPrefs[0].fgColorR;
	fgColorG = appPrefs[0].fgColorG;
	fgColorB = appPrefs[0].fgColorB;
	
	highlightR = appPrefs[0].highlightR;
	highlightG = appPrefs[0].highlightG;
	highlightB = appPrefs[0].highlightB;
	
	mainR = appPrefs[0].mainR;
	mainG = appPrefs[0].mainG;
	mainB = appPrefs[0].mainB;
	
	batteryR = appPrefs[0].batteryR;
	batteryG = appPrefs[0].batteryG;
	batteryB = appPrefs[0].batteryB;
	
	// Set other parameters
	interfaceMode = appPrefs[0].interfaceMode;
	widgetHighlight = appPrefs[0].widgetHighlight;
	widgetShadow = appPrefs[0].widgetShadow;
	cornerRadius = appPrefs[0].cornerRadius;
	useAnalogClockNumbers = appPrefs[0].useAnalogClockNumbers;
}


void composeBackgroundBuffer() {
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
	
	mainBuffer.begin();
	
	// Draw background
	mainBuffer.fgRGB(bgColorR, bgColorG, bgColorB);
	mainBuffer.rect(clrFG, mainForm.x, mainForm.y, mainForm.w, mainForm.h, 0);
	
	// Set & calculate colors
	mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
	calculateShadowColor(100);
	calculateHighlightColor(50);
	mainBuffer.bgRGB(bgShadowColorR, bgShadowColorG, bgShadowColorB);
	
	if (showWidget1) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX1+1, startY1+1, startX1+widgetW+1, startY1+widgetH+1, cornerRadius);
		// Main rectangle
		mainBuffer.rect(clrFG, startX1, startY1, startX1+widgetW, startY1+widgetH, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX1, startY1, widgetW, widgetH);
		}
	
	if (showWidget2) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX2+1, startY2+1, startX2+widgetW+1, startY2+widgetH+1, cornerRadius);
		// Main rectangle
		mainBuffer.rect(clrFG, startX2, startY2, startX2+widgetW, startY2+widgetH, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX2, startY2, widgetW, widgetH);
		}
	
	if (showWidget3) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX3+1, startY3+1, startX3+widgetW+1, startY3+widgetH+1, cornerRadius);
		// Main rectangle
		mainBuffer.rect(clrFG, startX3, startY3, startX3+widgetW, startY3+widgetH, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX3, startY3, widgetW, widgetH);
		}
	
	if (showWidget4) {
		// Shadow
		if (widgetShadow) mainBuffer.rect(clrBG, startX4+1, startX4+1, startX4+widgetW+1, startY4+widgetH+1, cornerRadius);
		// Main rectangle
		mainBuffer.rect(clrFG, startX4, startX4, startX4+widgetW, startY4+widgetH, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(startX4, startY4, widgetW, widgetH);
		}
	
	mainBuffer.end();
}


void composeWidgetsBuffer() {
	if (showWidget1) analogClockWidget(startX1, startY1);
	if (showWidget2) digitalClockWidget(startX2, startY2);
	if (showWidget3) calendarWidget(startX3, startY3);
	if (showWidget4) batteryWidget(startX4, startY4);
}


handler mainForm.onopen() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
	
	date.now();
	year = date.year;
	month = date.month;
	day = date.day;
	weekday = date.weekday;

	hours = date.hour;
	minutes = date.min;
	seconds = date.sec;
	
	charge = battery(false);
	
	showWidget1 = true;
	showWidget2 = true;
	showWidget3 = true;
	showWidget4 = true;
	
	timer(1);
}


handler mainForm.ondraw() {	
	if (mainForm.h > 160) {
		// Portrait mode
		showWidget1 = true;
		showWidget2 = false;
		showWidget3 = false;
		showWidget4 = false;
		
		widgetW = 144;
		widgetH = 144;
		
		miniPanelX1 = 14;
		miniPanelY1 = 170;
		
		miniPanelX2 = 61;
		miniPanelY2 = 170;
		
		miniPanelX3 = 108;
		miniPanelY3 = 170;
		
		miniPanelW = 38;
		miniPanelH = 38; // 45
		
		setMainPreferences();
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the bottom
		drawAuxiliarPanel("P"); // Portrait
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else if (mainForm.w > 160) {
		// Landscape mode
		showWidget1 = true;
		showWidget2 = false;
		showWidget3 = false;
		showWidget4 = false;
		
		widgetW = 144;
		widgetH = 144;
		
		miniPanelX1 = 170;
		miniPanelY1 = 15;
		
		miniPanelX2 = 170;
		miniPanelY2 = 62;
		
		miniPanelX3 = 170;
		miniPanelY3 = 109;
		
		miniPanelW = 38;
		miniPanelH = 38; // 45
		
		setMainPreferences();
		composeBackgroundBuffer();
		composeWidgetsBuffer();
		
		// Rectangle at the side
		drawAuxiliarPanel("L"); // Landscape
		
		// Mini widgets
		miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		miniCalendarWidget(miniPanelX2, miniPanelY2);
		miniBatteryWidget(miniPanelX3, miniPanelY3);
	}
	else
	{
		// Normal mode
		showWidget1 = true;
		showWidget2 = true;
		showWidget3 = true;
		showWidget4 = true;
		
		widgetW = 70;
		widgetH = 70;
		
		setMainPreferences();
		composeBackgroundBuffer();
		composeWidgetsBuffer();
	}
	
	// Draw mainBuffer
	draw.begin();
	draw.draw(mainBuffer, 0, 0);
	draw.end();
}


handler mainForm.ontimer() {
	date.now();
	seconds = date.sec;
	
	if (!mainForm.obscured && seconds != lastSecond) {
		year = date.year;
		month = date.month;
		day = date.day;
		weekday = date.weekday;
	
		hours = date.hour;
		minutes = date.min;
		
		charge = battery(false);
		
		// Widgets
		if (showWidget1) updateClockHands();
		
		if (showWidget2) {
			digitalClockWidget(startX2, startY2);
		}
		else
		{
			miniDigitalClockWidget(miniPanelX1, miniPanelY1);
		}
		
		if (showWidget3) {
			if (day != lastDay) calendarWidget(startX3, startY3);
		}
		else
		{
			miniCalendarWidget(miniPanelX2, miniPanelY2);
		}
		
		if (showWidget4) {
			if (charge != lastCharge) batteryWidget(startX4, startY4);
		}
		else
		{
			miniBatteryWidget(miniPanelX3, miniPanelY3);
		}
		
		// Draw mainBuffer
		draw.begin();
		draw.draw(mainBuffer, 0, 0); 
		draw.end();
	}
	
	lastSecond = seconds;
	lastMinute = minutes;
	lastDay = day;
	lastCharge = charge;
	timer(20);
}


handler mainForm.onresize() {
	// UIform attach this form for drawing methods
	draw.attachForm(this);
	
	// Create offscreen buffer
	mainBuffer.create(mainForm.w, mainForm.h);
}


