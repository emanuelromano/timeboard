// Set main preferences on global variables
void setMainPreferences() {
	debugFlag = appPrefs[appPrefsPosition].debugFlag;
	allSet = appPrefs[appPrefsPosition].allSet;
	
	// Set UI colors
	bgColorR = appPrefs[appPrefsPosition].bgColorR;
	bgColorG = appPrefs[appPrefsPosition].bgColorG;
	bgColorB = appPrefs[appPrefsPosition].bgColorB;
	
	if (allSet)
		bgColorIndex = appPrefs[appPrefsPosition].bgColorIndex;
	else
		bgColorIndex = draw.indexFromColor(bgColorR, bgColorG, bgColorB);
	
	fgColorR = appPrefs[appPrefsPosition].fgColorR;
	fgColorG = appPrefs[appPrefsPosition].fgColorG;
	fgColorB = appPrefs[appPrefsPosition].fgColorB;
	
	if (allSet)
		fgColorIndex = appPrefs[appPrefsPosition].fgColorIndex;
	else
		fgColorIndex = draw.indexFromColor(fgColorR, fgColorG, fgColorB);
	
	shadowR = appPrefs[appPrefsPosition].shadowR;
	shadowG = appPrefs[appPrefsPosition].shadowG;
	shadowB = appPrefs[appPrefsPosition].shadowB;
	
	if (allSet)
		shadowIndex = appPrefs[appPrefsPosition].shadowIndex;
	else
		shadowIndex = draw.indexFromColor(shadowR, shadowG, shadowB);
	
	highlightR = appPrefs[appPrefsPosition].highlightR;
	highlightG = appPrefs[appPrefsPosition].highlightG;
	highlightB = appPrefs[appPrefsPosition].highlightB;
	
	if (allSet)
		highlightIndex = appPrefs[appPrefsPosition].highlightIndex;
	else
		highlightIndex = draw.indexFromColor(highlightR, highlightG, highlightB);
	
	mainR = appPrefs[appPrefsPosition].mainR;
	mainG = appPrefs[appPrefsPosition].mainG;
	mainB = appPrefs[appPrefsPosition].mainB;
	
	mainIndex = appPrefs[appPrefsPosition].mainIndex;
	mainIndex = draw.indexFromColor(mainR, mainG, mainB);
	
	batteryR = appPrefs[appPrefsPosition].batteryR;
	batteryG = appPrefs[appPrefsPosition].batteryG;
	batteryB = appPrefs[appPrefsPosition].batteryB;
	
	batteryEmptyR = appPrefs[appPrefsPosition].batteryEmptyR;
	batteryEmptyG = appPrefs[appPrefsPosition].batteryEmptyG;
	batteryEmptyB = appPrefs[appPrefsPosition].batteryEmptyB;
	
	// Set other parameters
	origInterfaceMode = interfaceMode = appPrefs[appPrefsPosition].interfaceMode;
	widgetCornerRadius = appPrefs[appPrefsPosition].widgetCornerRadius;
	useAnalogClockNumbers = appPrefs[appPrefsPosition].useAnalogClockNumbers;
}


// Save main preferences from global variables
bool saveMainPreferences() {	
	// Specific theme settings for color themes
	if (colorDepth > 4) {
		appPrefs[appPrefsPosition].bgColorR = bgColorR;
		appPrefs[appPrefsPosition].bgColorG = bgColorG;
		appPrefs[appPrefsPosition].bgColorB = bgColorB;
		appPrefs[appPrefsPosition].bgColorIndex = bgColorIndex;
		
		appPrefs[appPrefsPosition].fgColorR = fgColorR;
		appPrefs[appPrefsPosition].fgColorG = fgColorG;
		appPrefs[appPrefsPosition].fgColorB = fgColorB;
		appPrefs[appPrefsPosition].fgColorIndex = fgColorIndex;
		
		appPrefs[appPrefsPosition].shadowR = shadowR;
		appPrefs[appPrefsPosition].shadowG = shadowG;
		appPrefs[appPrefsPosition].shadowB = shadowB;
		appPrefs[appPrefsPosition].shadowIndex = shadowIndex;
		
		appPrefs[appPrefsPosition].highlightR = highlightR;
		appPrefs[appPrefsPosition].highlightG = highlightG;
		appPrefs[appPrefsPosition].highlightB = highlightB;
		appPrefs[appPrefsPosition].highlightIndex = highlightIndex;
		
		appPrefs[appPrefsPosition].mainR = mainR;
		appPrefs[appPrefsPosition].mainG = mainG;
		appPrefs[appPrefsPosition].mainB = mainB;
		appPrefs[appPrefsPosition].mainIndex = mainIndex;
		
		appPrefs[appPrefsPosition].batteryR = batteryR;
		appPrefs[appPrefsPosition].batteryG = batteryG;
		appPrefs[appPrefsPosition].batteryB = batteryB;
		
		appPrefs[appPrefsPosition].batteryEmptyR = batteryEmptyR;
		appPrefs[appPrefsPosition].batteryEmptyG = batteryEmptyG;
		appPrefs[appPrefsPosition].batteryEmptyB = batteryEmptyB;
	}
	
	// General
	appPrefs[0].debugFlag = debugFlag;
	appPrefs[1].debugFlag = debugFlag;
	appPrefs[2].debugFlag = debugFlag;
	appPrefs[3].debugFlag = debugFlag;
	
	appPrefs[0].allSet = allSet;
	appPrefs[1].allSet = allSet;
	appPrefs[2].allSet = allSet;
	appPrefs[3].allSet = allSet;
	
	// B/W screens (1-bit)
	appPrefs[0].interfaceMode = origInterfaceMode;
	appPrefs[0].widgetCornerRadius = widgetCornerRadius;
	appPrefs[0].useAnalogClockNumbers = useAnalogClockNumbers;
	
	// Grayscale screens (2-bit)
	appPrefs[1].interfaceMode = origInterfaceMode;
	appPrefs[1].widgetCornerRadius = widgetCornerRadius;
	appPrefs[1].useAnalogClockNumbers = useAnalogClockNumbers;
	
	// Grayscale screens (4-bit)
	appPrefs[2].interfaceMode = origInterfaceMode;
	appPrefs[2].widgetCornerRadius = widgetCornerRadius;
	appPrefs[2].useAnalogClockNumbers = useAnalogClockNumbers;
	
	// Color screens (8-bit & 16-bit)
	appPrefs[3].interfaceMode = origInterfaceMode;
	appPrefs[3].widgetCornerRadius = widgetCornerRadius;
	appPrefs[3].useAnalogClockNumbers = useAnalogClockNumbers;
	
	return prefs.set(TimeBoard.creator, true, appPrefs, typeof(AppPrefs), numberOfPrefs);
}


// TimeBoard handler: Save preferences on app stop
handler TimeBoard.onstop() {
	saveMainPreferences();
}


