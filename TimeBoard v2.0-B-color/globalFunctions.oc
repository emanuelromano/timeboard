// Shadow color calculations
void calculateShadowColor(int amount) {

	bgShadowColorR = bgColorR - amount;
	bgShadowColorG = bgColorG - amount;
	bgShadowColorB = bgColorB - amount;

	if (bgShadowColorR < 0) bgShadowColorR = 0;
	if (bgShadowColorG < 0) bgShadowColorG = 0;
	if (bgShadowColorB < 0) bgShadowColorB = 0;
}


// Highlight color calculations
void calculateHighlightColor(int amount) {

	bgHighlightColorR = fgColorR + amount;
	bgHighlightColorG = fgColorG + amount;
	bgHighlightColorB = fgColorB + amount;

	if (bgHighlightColorR > 255) bgHighlightColorR = 255;
	if (bgHighlightColorG > 255) bgHighlightColorG = 255;
	if (bgHighlightColorB > 255) bgHighlightColorB = 255;
	
	if (fgColorR == 255 && fgColorG == 255 && fgColorB == 255 ) {
		bgHighlightColorR = 238;
		bgHighlightColorG = 238;
		bgHighlightColorB = 238;
	}
}


void drawWidgetHighlight(int startX, int startY, int width, int height) {
	int x10, x74, x77, x80, x83;
	int y10, y77, y80;
	int cornerRadiusAux;

	x10 = width * 10 / 100;
	x74 = width * 74 / 100;
	x77 = width * 77 / 100;
	x80 = width * 80 / 100;
	x83 = width * 83 / 100;

	y10 = height * 10 / 100;
	y77 = height * 77 / 100;
	y80 = height * 80 / 100;

	mainBuffer.fgRGB(
		bgHighlightColorR,
		bgHighlightColorG,
		bgHighlightColorB);
	
	// Top highlight
	mainBuffer.line(
		clrFG,
		startX + x10,
		startY + 1,
		startX + x74,
		startY + 1);

	mainBuffer.line(
		clrFG,
		startX + x77,
		startY + 1,
		startX + x80,
		startY + 1);

	mainBuffer.pixel(
		clrFG,
		startX + x83,
		startY + 1);

	// Left highlight
	mainBuffer.line(
		clrFG,
		startX + 1,
		startY + y10,
		startX + 1,
		startY + y77);

	mainBuffer.pixel(
		clrFG,
		startX + 1,
		startY + y80);
	
	// Corner radius correction
	if (cornerRadius <= 0)
		cornerRadiusAux = 1;
	else
		cornerRadiusAux = cornerRadius;
	
	// Bright corner
	mainBuffer.rect(
		clrFG,
		startX + 1,
		startY + 1,
		startX + (width * 20 / 100),
		startY + (height * 20 / 100),
		cornerRadiusAux - 1);
	
	mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.rect(
		clrFG,
		startX + 2,
		startY + 2,
		startX + (width * 20 / 100) + 2,
		startY + (height * 20 / 100) + 2,
		cornerRadiusAux - 1);
}


void splitDateDigits(int day) {
	dayDigit1 = day / 10;
	dayDigit2 = day % 10;
}


void splitTimeDigits() {
	// Hours
	hourDigit1 = hours / 10;
	hourDigit2 = hours % 10;

	// Minutes
	minuteDigit1 = minutes / 10;
	minuteDigit2 = minutes % 10;

	// Seconds
	secondDigit1 = seconds / 10;
	secondDigit2 = seconds % 10;
}


void drawDigit(int number, int digitW, int digitH, int digitX, int digitY, int radius) {
	bool segment1,
		segment2,
		segment3,
		segment4,
		segment5,
		segment6,
		segment7,
		segmentA,
		segmentB;
	
	switch (number) {
		case 0:
			segment1 = true;
			segment2 = false;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 1:
			segment1 = false;
			segment2 = false;
			segment3 = true;
			segment4 = false; //
			segment5 = false; //
			segment6 = false;
			segment7 = false;
			segmentA = true;
			segmentB = true;
			break;
		case 2:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = false;
			segment6 = false;
			segment7 = true;
			break;
		case 3:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = false;
			segment7 = false;
			break;
		case 4:
			segment1 = false;
			segment2 = true;
			segment3 = false;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = false;
			break;
		case 5:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = false;
			segment5 = true;
			segment6 = true;
			segment7 = false;
			break;
		case 6:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = false;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 7:
			segment1 = true;
			segment2 = false;
			segment3 = false;
			segment4 = true;
			segment5 = true;
			segment6 = false;
			segment7 = false;
			break;
		case 8:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;
		case 9:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = false;
			break;
	}
	
	// Erase old char
	mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.rect(clrBG, digitX, digitY, digitX+digitW, digitY+4, radius);
	mainBuffer.rect(clrBG, digitX, digitY+14, digitX+digitW, digitY+18, radius);
	mainBuffer.rect(clrBG, digitX, digitY+29, digitX+digitW, digitY+33, radius);
	
	mainBuffer.rect(clrBG, digitX+7, digitY, digitX+digitW, digitY+18, radius);
	mainBuffer.rect(clrBG, digitX+7, digitY+15, digitX+digitW, digitY+33, radius);
	
	mainBuffer.rect(clrBG, digitX, digitY, digitX+5, digitY+18, radius);
	mainBuffer.rect(clrBG, digitX, digitY+15, digitX+5, digitY+33, radius);
	
	mainBuffer.rect(clrBG, digitX, digitY, digitX+9, digitY+4, radius);
	mainBuffer.rect(clrBG, digitX+4, digitY, digitX+9, digitY+33, radius);
	
	// Main char
	if (segment1) mainBuffer.rect(clrFG, digitX, digitY, digitX+digitW, digitY+4, radius);
	if (segment2) mainBuffer.rect(clrFG, digitX, digitY+14, digitX+digitW, digitY+18, radius);
	if (segment3) mainBuffer.rect(clrFG, digitX, digitY+29, digitX+digitW, digitY+33, radius);
	
	if (segment4) mainBuffer.rect(clrFG, digitX+7, digitY, digitX+digitW, digitY+18, radius);
	if (segment5) mainBuffer.rect(clrFG, digitX+7, digitY+15, digitX+digitW, digitY+33, radius);
	
	if (segment6) mainBuffer.rect(clrFG, digitX, digitY, digitX+5, digitY+18, radius);
	if (segment7) mainBuffer.rect(clrFG, digitX, digitY+15, digitX+5, digitY+33, radius);
	
	if (segmentA) mainBuffer.rect(clrFG, digitX, digitY, digitX+9, digitY+4, radius);
	if (segmentB) mainBuffer.rect(clrFG, digitX+4, digitY, digitX+9, digitY+33, radius);
}


// Checks if TimeBoard Time Service is installed
bool isTBTSInstalled() {
	DatabaseMgr dbMgr;
	string appName;

	appName = dbMgr.dbenum(true, "appl", "TBTS");

	if (appName != "")
		return true;

	return false;
}
