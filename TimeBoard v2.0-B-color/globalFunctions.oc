// Shadow color calculations
void calculateShadowColor(int amount) {

	bgShadowColorR = bgColorR - amount;
	bgShadowColorG = bgColorG - amount;
	bgShadowColorB = bgColorB - amount;

	if (bgShadowColorR < 0) bgShadowColorR = 0;
	if (bgShadowColorG < 0) bgShadowColorG = 0;
	if (bgShadowColorB < 0) bgShadowColorB = 0;
}


// Highlight color calculations
void calculateHighlightColor(int amount) {

	bgHighlightColorR = fgColorR + amount;
	bgHighlightColorG = fgColorG + amount;
	bgHighlightColorB = fgColorB + amount;

	if (bgHighlightColorR > 255) bgHighlightColorR = 255;
	if (bgHighlightColorG > 255) bgHighlightColorG = 255;
	if (bgHighlightColorB > 255) bgHighlightColorB = 255;
	
	if (fgColorR == 255 && fgColorG == 255 && fgColorB == 255 ) {
		bgHighlightColorR = 221;
		bgHighlightColorG = 221;
		bgHighlightColorB = 221;
	}
}


void drawWidgetHighlight(int startX, int startY, int width, int height) {
	int x10, x74, x77, x80, x83,
		y10, y77, y80,
		cornerRadiusAux;

	x10 = width * 10 / 100;
	x74 = width * 74 / 100;
	x77 = width * 77 / 100;
	x80 = width * 80 / 100;
	x83 = width * 83 / 100;

	y10 = height * 10 / 100;
	y77 = height * 77 / 100;
	y80 = height * 80 / 100;

	mainBuffer.fgRGB(
		bgHighlightColorR,
		bgHighlightColorG,
		bgHighlightColorB);
	
	// Top highlight
	mainBuffer.line(
		clrFG,
		startX + x10,
		startY + 1,
		startX + x74,
		startY + 1);

	mainBuffer.line(
		clrFG,
		startX + x77,
		startY + 1,
		startX + x80,
		startY + 1);

	mainBuffer.pixel(
		clrFG,
		startX + x83,
		startY + 1);

	// Left highlight
	mainBuffer.line(
		clrFG,
		startX + 1,
		startY + y10,
		startX + 1,
		startY + y77);

	mainBuffer.pixel(
		clrFG,
		startX + 1,
		startY + y80);
	
	// Corner radius correction
	if (cornerRadius <= 0)
		cornerRadiusAux = 1;
	else
		cornerRadiusAux = cornerRadius;
	
	// Bright corner
	mainBuffer.rect(
		clrFG,
		startX + 1,
		startY + 1,
		startX + 20,
		startY + 20,
		cornerRadiusAux - 1);
	
	mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.rect(
		clrFG,
		startX + 2,
		startY + 2,
		startX + 23,
		startY + 23,
		cornerRadiusAux - 1);
}


void drawAuxiliarPanel(string orientation) {
	if (orientation == "P") {
		mainBuffer.begin();
		// Shadow
		mainBuffer.fgRGB(bgShadowColorR, bgShadowColorG, bgShadowColorB);
		if (widgetShadow) mainBuffer.rect(clrFG, mainForm.x+9, 161, mainForm.w-7, mainForm.h-7, cornerRadius);
		// Main rectangle
		mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
		mainBuffer.rect(clrFG, mainForm.x+8, 160, mainForm.w-8, mainForm.h-8, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(mainForm.x+8, 160, mainForm.w-8, 55);
		// Line separators
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.line(clrFG, mainForm.x+56, 168, mainForm.x+56, 208);
		mainBuffer.line(clrFG, mainForm.w-57, 168, mainForm.w-57, 208);
		
		// TESTING LOWER PANELS
		if (debugFlag) {
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.frame(clrFG, miniPanelX1, miniPanelY1, miniPanelX1+miniPanelW, miniPanelY1+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX2, miniPanelY2, miniPanelX2+miniPanelW, miniPanelY2+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX3, miniPanelY3, miniPanelX3+miniPanelW, miniPanelY3+miniPanelH, 0, 1);
		}
		mainBuffer.end();
	}
	
	if (orientation == "L") {
		mainBuffer.begin();
		// Shadow
		mainBuffer.fgRGB(bgShadowColorR, bgShadowColorG, bgShadowColorB);
		if (widgetShadow) mainBuffer.rect(clrFG, mainForm.x+161, 9, mainForm.w-7, mainForm.h-7, cornerRadius);
		// Main rectangle
		mainBuffer.fgRGB(fgColorR, fgColorG, fgColorB);
		mainBuffer.rect(clrFG, mainForm.x+160, 8, mainForm.w-8, mainForm.h-8, cornerRadius);
		// Highlight
		if (widgetHighlight) drawWidgetHighlight(mainForm.x+160, 8, 55, mainForm.h-8);
		// Line separators
		mainBuffer.fgRGB(highlightR, highlightG, highlightB);
		mainBuffer.line(clrFG, 168, mainForm.h-56, 208, mainForm.h-56);
		mainBuffer.line(clrFG, 168, mainForm.y+57, 208, mainForm.y+57);
		
		// TESTING LOWER PANELS
		if (debugFlag) {
			mainBuffer.fgRGB(mainR, mainG, mainB);
			mainBuffer.frame(clrFG, miniPanelX1, miniPanelY1, miniPanelX1+miniPanelW, miniPanelY1+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX2, miniPanelY2, miniPanelX2+miniPanelW, miniPanelY2+miniPanelH, 0, 1);
			mainBuffer.frame(clrFG, miniPanelX3, miniPanelY3, miniPanelX3+miniPanelW, miniPanelY3+miniPanelH, 0, 1);
		}
		mainBuffer.end();
	}
}


void splitDateDigits(int day) {
	dayDigit1 = day / 10;
	dayDigit2 = day % 10;
}


void splitTimeDigits() {
	// Hours
	hourDigit1 = hours / 10;
	hourDigit2 = hours % 10;

	// Minutes
	minuteDigit1 = minutes / 10;
	minuteDigit2 = minutes % 10;

	// Seconds
	secondDigit1 = seconds / 10;
	secondDigit2 = seconds % 10;
}


void drawSegment(int x1, int y1,
				 int x2, int y2,
				 int radius)
{
		mainBuffer.rect(clrFG, x1, y1, x2, y2, radius);
}


void drawDigit(int number,
			   int digitW,
			   int digitH,
			   int digitX,
			   int digitY,
			   int radius,
			   int segThickness)
{
	bool segment1 = false,
		 segment2 = false,
		 segment3 = false,
		 segment4 = false,
		 segment5 = false,
		 segment6 = false,
		 segment7 = false,
		 segmentA = false,
		 segmentB = false;

	int midY,
		midYCorrection,
		rightX;

	midY = digitH / 2;
	midYCorrection = 2;
	rightX = digitW - segThickness;

	switch (number) {

		case 0:
			segment1 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;

		case 1:
			segment3 = true;
			segmentA = true;
			segmentB = true;
			break;

		case 2:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment7 = true;
			break;

		case 3:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			break;

		case 4:
			segment2 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			break;

		case 5:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment5 = true;
			segment6 = true;
			break;

		case 6:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;

		case 7:
			segment1 = true;
			segment4 = true;
			segment5 = true;
			break;

		case 8:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			segment7 = true;
			break;

		case 9:
			segment1 = true;
			segment2 = true;
			segment3 = true;
			segment4 = true;
			segment5 = true;
			segment6 = true;
			break;
	}
	
	// ERASE OLD DIGIT
	mainBuffer.bgRGB(fgColorR, fgColorG, fgColorB);
	mainBuffer.rect(clrBG, digitX, digitY, digitX+digitW, digitY+digitH, 0);
	
	// DRAW NEW SEGMENTS
	// -------- Horizontal --------
	if (segment1) {
		drawSegment(digitX,
					digitY,
					digitX + digitW,
					digitY + segThickness,
					radius);
	}
	
	if (segment2) {
		drawSegment(digitX,
					digitY + midY - (segThickness / 2),
					digitX + digitW,
					digitY + midY + (segThickness / 2),
					radius);
	}
	
	if (segment3) {
		drawSegment(digitX,
					digitY + digitH - segThickness,
					digitX + digitW,
					digitY + digitH,
					radius);
	}
	
	// -------- Vertical right --------
	if (segment4) {
		drawSegment(digitX + rightX,
					digitY,
					digitX + digitW,
					digitY + midY + midYCorrection,
					radius);
	}
	
	if (segment5) {
		drawSegment(digitX + rightX,
					digitY + midY - midYCorrection,
					digitX + digitW,
					digitY + digitH,
					radius);
	}
	
	// -------- Vertical left --------
	if (segment6) {
		drawSegment(digitX,
					digitY,
					digitX + segThickness,
					digitY + midY + midYCorrection,
					radius);
	}
	
	if (segment7) {
		drawSegment(digitX,
					digitY + midY - midYCorrection,
					digitX + segThickness,
					digitY + digitH,
					radius);
	}
	
	// -------- Number 1 --------
	if (segmentA) {
		drawSegment(digitX,
					digitY,
					digitX + (digitW / 2),
					digitY + segThickness,
					radius);
	}

	if (segmentB) {
		drawSegment(digitX + (digitW / 2) - (segThickness / 2),
					digitY,
					digitX + (digitW / 2) + (segThickness / 2),
					digitY + digitH,
					radius);
	}
}


// Checks if TimeBoard Time Service is installed
bool isTBTSInstalled() {
	DatabaseMgr dbMgr;
	string appName;

	appName = dbMgr.dbenum(true, "appl", "TBTS");

	if (appName != "")
		return true;

	return false;
}

// Draw mainBuffer
void drawMainBuffer() {
	draw.begin();
	
	draw.draw(mainBuffer, 0, 0);
	
	if (debugFlag) draw.text(clrFG, 0, 0, "W: " + mainForm.w + " / H: " + mainForm.h);
	
	draw.end();
}