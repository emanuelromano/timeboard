}


// Main color selector
handler mainBtn.onselect() {
	if (draw.selectIndex("Choose main color:", &mainIndex)) {
		draw.begin();
		draw.fg(mainIndex);
		draw.rect(clrFG, 92, 91, 102, 101, 0);
		draw.end();
	}
	else
	{
		draw.begin();
		draw.fg(mainIndex);
		draw.rect(clrFG, 92, 91, 102, 101, 0);
		draw.end();
	}
}


handler colorsModalBackBtn.onselect() {
	colorsModalForm.close();
}


handler colorsModalSaveBtn.onselect() {
	saveMainPreferences();
	
	colorsModalForm.close();
}
